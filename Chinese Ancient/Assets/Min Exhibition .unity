--- !u!114 &816178827
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 816178823}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 31a41915fe269ee488049a7269a29a7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayText: {fileID: 253339946}
  introPanel: {fileID: 202010748}
  closeButton: {fileID: 2075575415}
  hoverColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  paragraphs:
  - "\u798F\u5EFA\u571F\u697C\u662F\u4E16\u754C\u4E0A\u72EC\u4E00\u65E0\u4E8C\u7684\u795E\u8BDD\u822C\u7684\u5C71\u6751\u6C11\u5C45\u5EFA\u7B51\uFF0C\u88AB\u8A89\u4E3A\"\u4E1C\u65B9\u53E4\u57CE\u5821\"\uFF0C\u662F\u4E2D\u56FD\u53E4\u5EFA\u7B51\u7684\u4E00\u6735\u5947\u8469\uFF0C\u4E5F\u662F\u4E2D\u534E\u6C11\u65CF\u4F20\u7EDF\u6C11\u5C45\u7684\u6770\u51FA\u4EE3\u8868\u3002\u5B83\u4EA7\u751F\u4E8E\u5B8B\u5143\u65F6\u671F\uFF0C\u5386\u7ECF\u6570\u767E\u5E74\u53D1\u5C55\uFF0C\u6210\u719F\u4E8E\u660E\u6E05\u4E24\u4EE3\uFF0C\u4E3B\u8981\u5206\u5E03\u5728\u798F\u5EFA\u7701\u9F99\u5CA9\u5E02\u6C38\u5B9A\u533A\u3001\u6F33\u5DDE\u5E02\u5357\u9756\u53BF\u548C\u534E\u5B89\u53BF\u7B49\u5730\u3002\u571F\u697C\u4EE5\u5F53\u5730\u7279\u6709\u7684\u751F\u571F\u4E3A\u4E3B\u8981\u5EFA\u7B51\u6750\u6599\uFF0C\u63BA\u4E0A\u6749\u6728\u6761\u3001\u7AF9\u7247\u3001\u62C9\u7ED3\u7B4B\u7B49\u8F85\u6599\uFF0C\u7ECF\u53CD\u590D\u8202\u538B\u3001\u592F\u7B51\u800C\u6210\uFF0C\u5899\u4F53\u539A\u5B9E\u575A\u56FA\uFF0C\u4E00\u822C\u9AD8\u4E09\u81F3\u4E94\u5C42\uFF0C\u5E95\u5C42\u4E3A\u53A8\u623F\u548C\u9910\u5385\uFF0C\u4E8C\u5C42\u4E3A\u7CAE\u4ED3\uFF0C\u4E09\u56DB\u5C42\u4E3A\u5367\u5BA4\uFF0C\u9876\u5C42\u5219\u7528\u4E8E\u5B58\u653E\u6742\u7269\uFF0C\u6574\u5EA7\u5EFA\u7B51\u53EF\u5BB9\u7EB3\u6570\u767E\u4EBA\u805A\u65CF\u800C\u5C45\uFF0C\u5F62\u6210\u4E86\u4E00\u4E2A\u81EA\u7ED9\u81EA\u8DB3\u3001\u5B88\u671B\u76F8\u52A9\u7684\u5927\u5BB6\u65CF\u751F\u6D3B\u5171\u540C\u4F53\u3002"
  - "2008\u5E747\u6708\uFF0C\u5728\u52A0\u62FF\u5927\u9B41\u5317\u514B\u57CE\u4E3E\u884C\u7684\u7B2C32\u5C4A\u4E16\u754C\u9057\u4EA7\u5927\u4F1A\u4E0A\uFF0C\u798F\u5EFA\u571F\u697C\u88AB\u6B63\u5F0F\u5217\u5165\u300A\u4E16\u754C\u6587\u5316\u9057\u4EA7\u540D\u5F55\u300B\uFF0C\u6210\u4E3A\u5168\u4EBA\u7C7B\u5171\u540C\u7684\u6587\u5316\u7470\u5B9D\u3002\u4E16\u754C\u9057\u4EA7\u59D4\u5458\u4F1A\u8BC4\u4EF7\u5176\u4E3A\"\u4E16\u754C\u4E0A\u72EC\u4E00\u65E0\u4E8C\u7684\u795E\u8BDD\u822C\u7684\u5C71\u6751\u6C11\u5C45\u5EFA\u7B51\"\uFF0C\u8D5E\u8A89\u5176\"\u4F53\u73B0\u4E86\u4EBA\u4E0E\u81EA\u7136\u548C\u8C10\u76F8\u5904\u7684\u5178\u8303\uFF0C\u4EE5\u53CA\u4EBA\u7C7B\u5728\u7279\u6B8A\u73AF\u5883\u4E0B\u521B\u9020\u51FA\u7684\u6770\u51FA\u5EFA\u7B51\u827A\u672F\"\u3002"
  - "\u672C\u5C55\u9986\u5C06\u5E26\u60A8\u8D70\u8FDB\u6C38\u5B9A\u3001\u5357\u9756\u7684\u5706\u5F62\u3001\u65B9\u5F62\u3001\u692D\u5706\u5F62\u571F\u697C\u7FA4\uFF0C\u8FD1\u8DDD\u79BB\u611F\u53D7\u592F\u571F\u5EFA\u7B51\u7684\u9707\u64BC\u4E4B\u7F8E\u4E0E\u8425\u9020\u667A\u6167\u3002\u5728\u8FD9\u91CC\uFF0C\u60A8\u5C06\u63A2\u5BFB\u5BA2\u5BB6\u4EBA\u4E3A\u8EB2\u907F\u6218\u4E71\u4ECE\u4E2D\u539F\u5357\u8FC1\u7684\u5386\u53F2\u8BB0\u5FC6\uFF0C\u4E86\u89E3\u4ED6\u4EEC\u5982\u4F55\u5728\u5D07\u5C71\u5CFB\u5CAD\u95F4\u5F00\u57A6\u5BB6\u56ED\u3001\u805A\u65CF\u800C\u5C45\uFF1B\u60A8\u5C06\u9886\u7565\"\u5929\u4EBA\u5408\u4E00\"\u7684\u4E1C\u65B9\u5C45\u4F4F\u54F2\u5B66\uFF0C\u4F53\u4F1A\u571F\u697C\u5EFA\u7B51\u5982\u4F55\u5DE7\u5999\u878D\u5408\u9632\u536B\u529F\u80FD\u4E0E\u5BB6\u65CF\u4F26\u7406\uFF0C\u5982\u4F55\u5728\u5C01\u95ED\u7684\u5916\u89C2\u4E0B\u8425\u9020\u6E29\u99A8\u7684\u5185\u90E8\u5EAD\u9662\u7A7A\u95F4\uFF1B\u60A8\u8FD8\u5C06\u611F\u53D7\u571F\u697C\u5C45\u6C11\u4E16\u4EE3\u76F8\u4F20\u7684\u6C11\u4FD7\u98CE\u60C5\uFF0C\u8046\u542C\u90A3\u56DE\u8361\u5728\u73AF\u5F62\u56DE\u5ECA\u4E2D\u7684\u5BA2\u5BB6\u5C71\u6B4C\uFF0C\u54C1\u5473\u8FD9\u51DD\u56FA\u5728\u9EC4\u571F\u4E2D\u7684\u4E2D\u534E\u6587\u8109\u3002\u8BA9\u6211\u4EEC\u4E00\u540C\u5F00\u542F\u8FD9\u573A\u7A7F\u8D8A\u65F6\u7A7A\u7684\u6587\u5316\u4E4B\u65C5\uFF0C\u63A2\u5BFB\u4E1C\u65B9\u5EFA\u7B51\u5947\u8FF9\u80CC\u540E\u7684\u5386\u53F2\u5BC6\u7801\u4E0E\u4EBA\u6587\u7CBE\u795E\u3002"
  typingSpeed: 0.05
  displayDuration: 2.5
  autoCloseDelay: 3
