  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\u66F4\u592B\u5927\u4F2F"
  rootNode:
    npcLines:
    - "\u54CE\u5440\u2026\u2026\u8FD9\u53EF\u600E\u4E48\u529E\u2026\u2026\u8FD9\u53EF\u600E\u4E48\u529E\u2026\u2026"
    - "\u660E\u660E\u5C31\u63E3\u5728\u8EAB\u4E0A\u7684\uFF0C\u600E\u4E48\u5C31\u4E0D\u89C1\u4E86\u5462\u2026\u2026"
    - "\u8FD9\u4F4D\u5BA2\u5B98\uFF0C\u4F60\u6765\u5F97\u6B63\u597D\uFF01\u8001\u6C49\u6211\u662F\u8FD9\u5927\u9662\u91CC\u7684\u66F4\u706F\u4EBA\uFF0C\u7BA1\u7740\u6BCF\u65E5\u70B9\u706F\u7B3C\u7684\u5DEE\u4E8B\u3002"
    - "\u518D\u8FC7\u534A\u4E2A\u65F6\u8FB0\uFF0C\u5BB6\u4E3B\u5C31\u8BE5\u5DE1\u9662\u4E86\u3002\u53EF\u504F\u504F\u8FD9\u65F6\u5019\uFF0C\u6211\u90A3\u706B\u6298\u5B50\u627E\u4E0D\u7740\u4E86\uFF01"
    - "\u6CA1\u6709\u706B\u6298\u5B50\uFF0C\u8FD9\u6EE1\u9662\u7684\u7EA2\u706F\u7B3C\u5C31\u4EAE\u4E0D\u8D77\u6765\u3002\u706F\u7B3C\u4E0D\u4EAE\uFF0C\u5BB6\u4E3B\u90A3\u8FB9\u6211\u53EF\u600E\u4E48\u4EA4\u4EE3\u2026\u2026"
    - "\u5BA2\u5B98\uFF0C\u8001\u6C49\u817F\u811A\u4E0D\u5229\u7D22\uFF0C\u8DD1\u4E0D\u5FEB\u3002\u80FD\u4E0D\u80FD\u52B3\u70E6\u4F60\u5E2E\u6211\u5728\u8FD9\u9662\u91CC\u627E\u627E\uFF1F"
    - "\u706B\u6298\u5B50\u5C31\u8FD9\u4E48\u957F\u4E00\u622A\uFF0C\u7AF9\u7B52\u5B50\u88F9\u7740\uFF0C\u4E00\u5934\u70E7\u5F97\u9ED1\u9ED1\u7684\u3002\u65B9\u624D\u6211\u660E\u660E\u63E3\u5728\u8170\u95F4\uFF0C\u8BB8\u662F\u8D70\u5F97\u6025\uFF0C\u6389\u5728\u54EA\u513F\u4E86\u2026\u2026"
    - "\u5BA2\u5B98\u82E5\u662F\u5BFB\u7740\u4E86\uFF0C\u5343\u4E07\u62FF\u6765\u7ED9\u8001\u6C49\uFF01\u8FD9\u706F\u7B3C\u518D\u4E0D\u70B9\u4E0A\uFF0C\u5BB6\u4E3B\u602A\u7F6A\u4E0B\u6765\uFF0C\u6211\u8FD9\u5DEE\u4E8B\u6015\u662F\u8981\u4E22\u4E86\uFF01"
    choices:
    - optionText: "\u63A5\u53D7"
      nextNode:
        npcLines:
        - "\u5BA2\u5B98\u613F\u610F\u5E2E\u5FD9\uFF1F\u592A\u597D\u4E86\u592A\u597D\u4E86\uFF01\u8001\u6C49\u8FD9\u817F\u811A\u6B63\u6101\u8DD1\u4E0D\u52A8\u5462\u3002\u5BA2\u5B98\u6162\u6162\u5BFB\uFF0C\u8001\u6C49\u5728\u8FD9\u513F\u5019\u7740\uFF0C\u7B49\u706B\u6298\u5B50\u5230\u4E86\uFF0C\u706F\u7B3C\u7ACB\u9A6C\u5C31\u80FD\u4EAE\u8D77\u6765\uFF01\u591A\u8C22\u5BA2\u5B98\uFF0C\u591A\u8C22\u5BA2\u5B98\uFF01"
        choices: []
        onNodeTriggerEvent:
          m_PersistentCalls:
            m_Calls: []
    - optionText: "\u62D2\u7EDD"
      nextNode:
        npcLines:
        - "\u73B0\u5728\u7684\u5E74\u8F7B\u4EBA\u554A..."
        choices: []
