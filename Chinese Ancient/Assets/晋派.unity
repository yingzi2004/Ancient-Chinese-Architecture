  expressionPortraits: []
  welcomeDialogue:
  - "\u6B22\u8FCE\u6765\u5230\u6C11\u4FD7\u6587\u5316\u5C55\u89C8\u9986\uFF01"
  - "\u8FD9\u91CC\u5C55\u793A\u4E86\u4E2D\u56FD\u4E30\u5BCC\u591A\u5F69\u7684\u6C11\u4FD7\u6587\u5316\uFF0C\u5305\u62EC\u4F20\u7EDF\u5EFA\u7B51\u3001\u751F\u6D3B\u7528\u5177\u3001\u6587\u5316\u4E60\u4FD7\u7B49\u3002"
  - "\u60A8\u53EF\u4EE5\u81EA\u7531\u53C2\u89C2\u5404\u4E2A\u5C55\u533A\uFF0C\u4E86\u89E3\u4E0D\u540C\u5730\u533A\u7684\u6C11\u4FD7\u7279\u8272\u3002"
  - "\u6309 L \u952E\u53EF\u4EE5\u63A8\u8FDB\u5BF9\u8BDD\uFF0C\u795D\u60A8\u53C2\u89C2\u6109\u5FEB\uFF01"
  highlightKeywords: []
  highlightColor: {r: 1, g: 0.84, b: 0, a: 1}
  playEndVFX: 0
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
--- !u!114 &837534545
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 837534542}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9b519bef13f851e498ea3de1c5e8e5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerOnce: 1
  triggerDelay: 0.3
  npcDisplayName: "\u6309L\u952E\u7EE7\u7EED  \u5C0F\u5FAE"
  portraitSprite: {fileID: 21300000, guid: 5a5dd07a7cc5b8240a4e552535fe2fd5, type: 3}
  expressionPortraits:
  - {fileID: 0}
  - {fileID: 21300000, guid: db900c40afa5ba049a1b31455c9d4df9, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: 415272f0dd9d9b44fa21b628b880cb5c, type: 3}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 21300000, guid: db900c40afa5ba049a1b31455c9d4df9, type: 3}
  dialogueLines:
  - "\u77A7\uFF0C\u706F\u7B3C\u5168\u4EAE\u8D77\u6765\u5566\u2014\u2014\u8FD9\u624D\u5BF9\u561B\uFF01\u65B9\u624D\u9ED1\u7740\u51E0\u76CF\uFF0C\u603B\u89C9\u5F97\u5C11\u4E86\u70B9\u4EC0\u4E48\u3002"
  - "\u5BA2\u5B98\u4F60\u7EC6\u770B\u8FD9\u5ECA\u4E0B\u7684\u6728\u96D5\u3001\u5899\u4E0A\u7684\u7816\u82B1\u2014\u2014\u8FD9\u513F\u4E00\u6735\u83B2\u82B1\uFF0C\u90A3\u513F\u4E00\u53EA\u745E\u517D\uFF0C\u95E8\u58A9\u4E0A\u8FD8\u8E72\u7740\u5C0F\u72EE\u5B50\u5462\u3002\u8FD9\u664B\u5546\u7684\u5927\u9662\u513F\u5440\uFF0C\u8BB2\u7A76\u7684\u662F\u2018\u65E0\u6728\u4E0D\u523B\uFF0C\u65E0\u77F3\u4E0D\u96D5\u2019\u3002"
  - "\u4ED6\u4EEC\u628A\u798F\u6C14\u548C\u5FC3\u613F\uFF0C\u90FD\u5B89\u5B89\u9759\u9759\u5730\u523B\u5728\u8FD9\u4E9B\u77F3\u5934\u548C\u6728\u5934\u91CC\u4E86\uFF0C\u51E0\u767E\u5E74\u4E86\u8FD8\u5728\u8FD9\u513F\u5B88\u7740"
  - "\u8BF4\u8D77\u6765\u5440\uFF0C\u8FD9\u5927\u9662\u91CC\u7684\u4E1C\u897F\uFF0C\u8BA9\u6211\u60F3\u8D77\u81EA\u4E2A\u513F\u521A\u5728\u8FD9\u5377\u91CC\u9192\u6765\u7684\u65F6\u5019\u3002"
  - "\u6709\u4E00\u56DE\u6211\u77A7\u89C1\u8D26\u623F\u91CC\u6401\u7740\u4E00\u628A\u5927\u7B97\u76D8\uFF0C\u73E0\u5B50\u5706\u6E9C\u6E9C\u7684\uFF0C\u6211\u77A7\u7740\u597D\u73A9\uFF0C\u5C31\u8DD1\u53BB\u4E71\u62E8\u2014\u2014\u4E00\u4E0A\u4E00\uFF0C\u4E8C\u4E0A\u4E8C\uFF0C\u4E09\u4E0B\u4E94\u9664\u4E8C\u2026\u2026"
  - "\u54B3\uFF0C\u53E3\u8BC0\u5012\u662F\u5FF5\u5F97\u50CF\u6A21\u50CF\u6837\uFF0C\u53EF\u6570\u513F\u5168\u7B97\u9519\u4E86\uFF01\u4EBA\u5BB6\u664B\u5546\u5B50\u5F1F\u4ECE\u5C0F\u62E8\u7B97\u76D8\uFF0C\u62E8\u7684\u662F\u8D26\u672C\u4E0A\u7684\u771F\u91D1\u767D\u94F6\uFF0C\u8BB2\u7A76\u7684\u662F\u5206\u6BEB\u4E0D\u5DEE\u3002\u6211\u5440\uFF0C\u7EAF\u5C5E\u778E\u95F9\u817E\uFF01"
  - "\u597D\u5566\uFF0C\u8FD9\u5927\u9662\u7684\u706F\u7B3C\u4E5F\u4EAE\u4E86\uFF0C\u664B\u5546\u7684\u7816\u96D5\u6728\u96D5\u5BA2\u5B98\u4E5F\u77A7\u8FC7\u5566"
  - "\u63A5\u4E0B\u6765\u561B\u2014\u2014\u5F80\u5317\u8FB9\u8D70\uFF0C\u5C31\u662F\u8FD9\u8D9F\u65C5\u7A0B\u7684\u538B\u8F74\u7AD9\uFF0C\u5929\u575B\u7684\u5C55\u9986\u4E86"
  - "\u5BA2\u5B98\u4EC0\u4E48\u65F6\u5019\u60F3\u53BB\uFF0C\u6309\u2018\u54CE\u59C6\u2019\u5C55\u5F00\u53E4\u5377\u8F74\u70B9\u4E00\u4E0B\u4FBF\u662F\u3002\u5C0F\u5FAE\u5728\u90A3\u513F\u7B49\u7740\uFF0C\u4E0D\u6025"
  highlightKeywords:
  - "\u538B\u8F74\u7AD9"
  - "\u54CE\u59C6"
  highlightColor: {r: 0.8301887, g: 0.16838734, b: 0.18219958, a: 1}
  locationName: "\u672A\u547D\u540D\u4F4D\u7F6E"
