  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d7f3758a5a54154c8cb7b69ac03a5b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerDelay: 0.5
  triggerOnce: 1
  guideName: "\u6C11\u4FD7\u5C55\u89C8\u8BB2\u89E3\u5458"
  guidePortrait: {fileID: 21300000, guid: 7cfd1018251d399469511d7a8a8d5a04, type: 3}
  expressionPortraits: []
  welcomeDialogue:
  - "\u6B22\u8FCE\u6765\u5230\u6C11\u4FD7\u6587\u5316\u5C55\u89C8\u9986\uFF01"
  - "\u8FD9\u91CC\u5C55\u793A\u4E86\u4E2D\u56FD\u4E30\u5BCC\u591A\u5F69\u7684\u6C11\u4FD7\u6587\u5316\uFF0C\u5305\u62EC\u4F20\u7EDF\u5EFA\u7B51\u3001\u751F\u6D3B\u7528\u5177\u3001\u6587\u5316\u4E60\u4FD7\u7B49\u3002"
  - "\u60A8\u53EF\u4EE5\u81EA\u7531\u53C2\u89C2\u5404\u4E2A\u5C55\u533A\uFF0C\u4E86\u89E3\u4E0D\u540C\u5730\u533A\u7684\u6C11\u4FD7\u7279\u8272\u3002"
  - "\u6309 L \u952E\u53EF\u4EE5\u63A8\u8FDB\u5BF9\u8BDD\uFF0C\u795D\u60A8\u53C2\u89C2\u6109\u5FEB\uFF01"
  highlightKeywords: []
  highlightColor: {r: 1, g: 0.84, b: 0, a: 1}
  playEndVFX: 0
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
--- !u!114 &231714525
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 231714522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9b519bef13f851e498ea3de1c5e8e5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerOnce: 1
  triggerDelay: 0.3
  npcDisplayName: "\u6309L\u952E\u7EE7\u7EED  \u5C0F\u5FAE"
  portraitSprite: {fileID: 21300000, guid: 5a5dd07a7cc5b8240a4e552535fe2fd5, type: 3}
  expressionPortraits:
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: db900c40afa5ba049a1b31455c9d4df9, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  - {fileID: 21300000, guid: 43988e641f93ed346958aa97c2fbdad1, type: 3}
  dialogueLines:
  - "\u54A6\uFF1F\u5BA2\u5B98\uFF0C\u8FD9\u5929\u600E\u4E48\u2014\u2014"
  - "\u54B1\u4EEC\u8FDB\u6765\u7684\u65F6\u5019\u8FD8\u662F\u5927\u767D\u5929\u5462\uFF0C\u600E\u4E48\u4E00\u8E0F\u8FDB\u8FD9\u9662\u5B50\uFF0C\u5C31\u53D8\u6210\u665A\u4E0A\u4E86\uFF1F"
  - "\u8FD9\u53E4\u5377\u91CC\u7684\u65F6\u8FB0\u5440\uFF0C\u5C0F\u5FAE\u4E5F\u6478\u4E0D\u900F\u3002\u6709\u65F6\u65E5\u5934\u6B63\u597D\uFF0C\u6709\u65F6\u661F\u6708\u5F53\u7A7A\uFF0C\u5168\u51ED\u5B83\u81EA\u4E2A\u513F\u9AD8\u5174\u3002\u4E0D\u8FC7\u5BA2\u5B98\u4F60\u77A7\u2014\u2014"
  - "\u8FD9\u664B\u5546\u7684\u5927\u9662\u513F\uFF0C\u504F\u504F\u8981\u5230\u4E86\u591C\u91CC\u624D\u6700\u6709\u5473\u9053\u3002\u7EA2\u706F\u7B3C\u4E00\u76CF\u4E00\u76CF\u4EAE\u8D77\u6765\uFF0C\u628A\u9752\u7816\u7070\u74E6\u90FD\u6620\u5F97\u6696\u6D0B\u6D0B\u7684\u3002\u8001\u664B\u5546\u4EEC\u7BA1\u8FD9\u53EB\u2018\u65E5\u5B50\u7EA2\u706B\u2019\uFF0C\u6302\u5F97\u8D8A\u9AD8\uFF0C\u798F\u6C14\u8D8A\u65FA"
  - "\u6240\u4EE5\u5440\uFF0C\u867D\u8BF4\u8FD9\u5377\u91CC\u7684\u65F6\u8FB0\u98A0\u4E09\u5012\u56DB\u7684\uFF0C\u4F46\u80FD\u7ED9\u5BA2\u5B98\u649E\u4E0A\u8FD9\u4E48\u4E2A\u706F\u7B3C\u591C\u666F\uFF0C\u5C0F\u5FAE\u5012\u89C9\u5F97\u2014\u2014\u8D5A\u5230\u5566\uFF01"
  - "\uFF08\u5C0F\u5FAE\u5FFD\u7136\u6B6A\u4E86\u6B6A\u5934\uFF0C\u76EE\u5149\u843D\u5728\u4E0D\u8FDC\u5904\u4E00\u7247\u6697\u6DE1\u7684\u706F\u7B3C\u4E0A\uFF09\u8BF6\uFF1F\u4E0D\u8FC7\u2026\u2026\u90A3\u8FB9\u51E0\u76CF\u706F\u7B3C\uFF0C\u600E\u4E48\u662F\u6697\u7684\uFF1F\u7167\u7406\u8BF4\u8FD9\u4E2A\u65F6\u8FB0\uFF0C\u65E9\u8BE5\u6709\u4EBA\u6765\u70B9\u4E0A\u4E86\u5440"
  - "\uFF08\u5C0F\u5FAE\u8E2E\u8D77\u811A\u5F20\u671B\u4E86\u4E00\u4E0B\uFF09\u5BA2\u5B98\u4F60\u77A7\uFF0C\u90A3\u8FB9\u7AD9\u7740\u4F4D\u5927\u4F2F\uFF0C\u6025\u5F97\u76F4\u8F6C\u5708\u5462\uFF0C\u597D\u50CF\u5728\u627E\u4EC0\u4E48\u4E1C\u897F\uFF0C\u54B1\u4EEC\u8FC7\u53BB\u77A7\u77A7\uFF1F"
  highlightKeywords:
  - "\u7941\u53BF\u526A\u7EB8"
  - "\u9C7C\u620F\u83B2"
  highlightColor: {r: 0.8301887, g: 0.16838734, b: 0.18219958, a: 1}
  locationName: "\u672A\u547D\u540D\u4F4D\u7F6E"
  portraitRevealIndex: 0
  nameRevealIndex: 0
  globalPreventSameDialogue: 0
  playEndVFX: 0
  sharedGroupID: 
