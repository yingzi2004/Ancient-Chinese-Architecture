  alternateNodes:
  - npcLines:
    - "\u627E\u7740\u4E86\uFF1F\u54CE\u5440\uFF01\u6B63\u662F\u5B83\uFF01\u6B63\u662F\u5B83\uFF01"
    - "\u5BA2\u5B98\u4F60\u53EF\u6551\u4E86\u8001\u6C49\u7684\u6025\u4E86\uFF01\u8FD9\u4E0B\u706F\u7B3C\u80FD\u70B9\u4E0A\u4E86\uFF0C\u5BB6\u4E3B\u90A3\u8FB9\u4E5F\u603B\u7B97\u6709\u4E2A\u4EA4\u4EE3\uFF01"
    - "\u54B3\uFF0C\u8BF4\u8D77\u6765\u5440\u2026\u2026\u65B9\u624D\u620F\u53F0\u90A3\u8FB9\u5531\u4E86\u4E00\u51FA\u300A\u6253\u91D1\u679D\u300B\uFF0C\u8001\u6C49\u6211\u542C\u5F97\u5165\u4E86\u8FF7\uFF0C\u811A\u5E95\u4E0B\u632A\u4E0D\u52A8\u9053\u513F\u3002\u8FD9\u706B\u6298\u5B50\u516B\u6210\u5C31\u662F\u90A3\u4F1A\u513F\u6389\u7684\uFF0C\u6211\u7ADF\u4E00\u70B9\u513F\u6CA1\u5BDF\u89C9\uFF01"
    - "\u4E00\u628A\u5E74\u7EAA\u4E86\u8FD8\u8FD9\u822C\u8D2A\u70ED\u95F9\uFF0C\u9669\u4E9B\u8BEF\u4E86\u6B63\u4E8B\u3002\u5BA2\u5B98\u4F60\u53EF\u522B\u7B11\u8BDD\u8001\u6C49\u554A\uFF01"
    - "\u5BA2\u5B98\u7A0D\u7B49\uFF0C\u8001\u6C49\u8FD9\u5C31\u628A\u706F\u7B3C\u4E00\u76CF\u4E00\u76CF\u4EAE\u8D77\u6765\u2014\u2014"
    - "\u4ECA\u65E5\u591A\u4E8F\u4E86\u5BA2\u5B98\u3002\u8001\u6C49\u4E5F\u6CA1\u4EC0\u4E48\u597D\u8C22\u7684\uFF0C\u5F80\u540E\u5BA2\u5B98\u8D70\u5230\u54EA\u513F\uFF0C\u8FD9\u706F\u7B3C\u7684\u5149\u5C31\u7B97\u7ED9\u5BA2\u5B98\u7167\u7740\u8DEF\u5566\uFF01\n"
