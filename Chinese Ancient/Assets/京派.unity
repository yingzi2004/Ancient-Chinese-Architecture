  - {fileID: 0}
  - {fileID: 21300000, guid: d86bbc0b2e35bee41850cc1b59ee7a2d, type: 3}
  dialogueLines:
  - "\u5BA2\u5B98\uFF0C\u8FD9\u4E00\u7A0B\u2026\u2026\u8D70\u5230\u8FD9\u513F\u5566\uFF01"
  - "\u4ECE\u571F\u697C\u7684\u592F\u571F\uFF0C\u5230\u56ED\u6797\u7684\u82B1\u7A97\uFF0C\u5230\u5927\u9662\u7684\u7816\u96D5\uFF0C\u518D\u5230\u8FD9\u5929\u575B\u7684\u9999\u706B\u2026\u2026\u5C0F\u5FAE\u966A\u5BA2\u5B98\u8D70\u4E86\u597D\u8FDC\u597D\u8FDC\u7684\u8DEF\u5462\u3002"
  - "\u5BA2\u5B98\u8981\u56DE\u53BB\u5566\u3002\u5C0F\u5FAE\u77E5\u9053\u7684\u3002"
  - "\u4E0D\u8FC7\u5440\uFF0C\u5C0F\u5FAE\u4E00\u70B9\u513F\u4E5F\u4E0D\u96BE\u8FC7\u2014\u2014\u56E0\u4E3A\u50CF\u5BA2\u5B98\u8FD9\u6837\uFF0C\u613F\u610F\u6162\u6162\u8D70\u3001\u7EC6\u7EC6\u77A7\uFF0C\u628A\u8001\u623F\u5B50\u8001\u6728\u5934\u90FD\u88C5\u8FDB\u5FC3\u91CC\u7684\u4EBA\uFF0C\u5F80\u540E\u4E00\u5B9A\u8FD8\u4F1A\u6709\u3002"
  - "\u8FD9\u5377\u53E4\u5377\u5440\uFF0C\u8FD8\u4F1A\u518D\u644A\u5F00\u3002\u5230\u65F6\u5019\uFF0C\u5C0F\u5FAE\u4F1A\u8DDF\u4E0B\u4E00\u4E2A\u2018\u5BA2\u5B98\u2019\u8BF4\uFF1A\u4F60\u77E5\u9053\u5417\uFF0C\u5728\u4F60\u4E4B\u524D\uFF0C\u4E5F\u6709\u4E2A\u4EBA\uFF0C\u4ECE\u5357\u8D70\u5230\u5317\uFF0C\u628A\u8FD9\u4E00\u8DEF\u7684\u5999\u5904\u90FD\u6536\u8FDB\u773C\u5E95\u5566\u3002"
  - "\u6240\u4EE5\u5BA2\u5B98\uFF0C\u8FD9\u4E0D\u7B97\u544A\u522B\u3002\u4F60\u53EA\u662F\u4F1A\u8D70\u5411\u66F4\u8FDC\u7684\u5730\u65B9\uFF0C\u63A2\u8BBF\u66F4\u591A\u7684\u597D\u98CE\u666F\u54E6\uFF01"
  - "\u53BB\u5427\u53BB\u5427\uFF0C\u5C0F\u5FAE\u5C31\u5728\u8FD9\u513F\uFF0C\u7B49\u7740\u4E0B\u4E00\u4F4D\u613F\u610F\u6162\u6162\u8D70\u7684\u4EBA\uFF01"
