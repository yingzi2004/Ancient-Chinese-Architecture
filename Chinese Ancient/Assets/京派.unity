  portraitSprite: {fileID: 21300000, guid: d0675f73109c3e4498154f48a6726c41, type: 3}
  expressionPortraits:
  - {fileID: 0}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
