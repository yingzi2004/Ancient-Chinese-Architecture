  expressionPortraits:
  - {fileID: 0}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 75a90b6bb3626cb4b92d356d1538e904, type: 3}
  - {fileID: 21300000, guid: d86bbc0b2e35bee41850cc1b59ee7a2d, type: 3}
  - {fileID: 0}
  dialogueLines:
  - "\u5BA2\u5B98\uFF0C\u4F60\u77A7\u8FD9\u9999\u7089\u2014\u2014\u53E4\u65F6\u5019\u5440\uFF0C\u5929\u575B\u8FD9\u5730\u65B9\u53EF\u4E0D\u662F\u968F\u4FBF\u80FD\u8FDB\u6765\u7684\u3002\u6BCF\u5E74\u51AC\u81F3\uFF0C\u7687\u4E0A\u4EB2\u81EA\u9886\u7740\u6587\u6B66\u767E\u5B98\uFF0C\u5728\u8FD9\u575B\u4E0A\u711A\u9999\u796D\u5929\uFF0C\u6C42\u7684\u662F\u98CE\u8C03\u96E8\u987A\u3001\u4E94\u8C37\u4E30\u767B\u3001\u56FD\u6CF0\u6C11\u5B89\u3002"
  - "\u90A3\u4E00\u70B7\u9999\u71C3\u8D77\u6765\uFF0C\u9752\u70DF\u8885\u8885\u5F80\u5929\u4E0A\u8D70\uFF0C\u50CF\u662F\u628A\u4EBA\u95F4\u7684\u7948\u613F\uFF0C\u4E00\u5B57\u4E00\u53E5\u8BF4\u7ED9\u5929\u8001\u7237\u542C\u3002"
  - "\u6240\u4EE5\u8FD9\u70E7\u9999\u7948\u798F\u5440\uFF0C\u8BB2\u7A76\u7684\u5C31\u662F\u4E00\u4E2A\u2018\u8BDA\u2019\u5B57\u3002\u5FC3\u8BDA\u4E86\uFF0C\u9999\u706B\u81EA\u7136\u5C31\u65FA\u4E86\u3002\r\n"
  - "\u5BA2\u5B98\u8981\u4E0D\u8981\u4E5F\u2014\u2014"
  - "\uFF08\u6123\u4E86\u4E00\u4E0B\uFF0C\u7728\u7728\u773C\uFF09\u8BF6\uFF1F\u539F\u6765\u90A3\u4F4D\u59D1\u5A18\u53EB\u5C0F\u6D1B\u5440\uFF01\u5979\u65B9\u624D\u62DB\u547C\u5BA2\u5B98\uFF0C\u4FBF\u662F\u8BA9\u5BA2\u5B98\u6765\u8FD9\u513F\u7948\u798F\u7684\uFF1F"
  - "\u54C8\u54C8\uFF0C\u770B\u6765\u662F\u5C0F\u5FAE\u591A\u5634\u5566\uFF01\u5BA2\u5B98\u5FC3\u91CC\u65E9\u5C31\u6709\u6570\u4E86\u561B\uFF01"
  - "\u90A3\u8FD8\u7B49\u4EC0\u4E48\uFF1F\u5FEB\u53BB\u5FEB\u53BB\uFF01\u8BDA\u5FC3\u8BDA\u610F\u4E0A\u4E00\u70B7\u9999\uFF0C\u628A\u8FD9\u8D9F\u4ECE\u5357\u8D70\u5230\u5317\u7684\u65C5\u7A0B\uFF0C\u597D\u597D\u6536\u4E2A\u5C3E\uFF01"
  highlightKeywords: []
  highlightColor: {r: 1, g: 0.84, b: 0, a: 1}
  locationName: "\u672A\u547D\u540D\u4F4D\u7F6E"
