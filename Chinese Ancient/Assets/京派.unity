  - {fileID: 0}
  dialogueLines:
  - "\u5BA2\u5B98\uFF0C\u54B1\u4EEC\u5230\u4E86\u2014\u2014\u8FD9\u56DE\u53EF\u662F\u771F\u6B63\u7684\u5929\u575B\u5566\uFF01"
  - "\u8FD9\u4E00\u8DEF\uFF0C\u54B1\u4EEC\u4ECE\u798F\u5EFA\u7684\u571F\u697C\u51FA\u53D1\uFF0C\u7A7F\u8FC7\u82CF\u5DDE\u56ED\u6797\u7684\u82B1\u7A97\uFF0C\u6478\u8FC7\u664B\u5546\u5927\u9662\u7684\u7816\u96D5\u2026\u2026\u5982\u4ECA\uFF0C\u603B\u7B97\u8D70\u5230\u8FD9\u6700\u540E\u4E00\u7A0B\u4E86\uFF01"
  - "\u4ECE\u5357\u5230\u5317\uFF0C\u4E00\u7A0B\u4E00\u7A0B\u8D70\u8FC7\u6765\uFF0C\u6BCF\u4E00\u5904\u90FD\u6709\u6BCF\u4E00\u5904\u7684\u5999\u5904\uFF0C\u662F\u4E0D\u662F\uFF1F"
