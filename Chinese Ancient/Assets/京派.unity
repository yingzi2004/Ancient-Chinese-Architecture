--- !u!114 &1036058110
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1036058108}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c024abeb76515de4d948aeed63da3d39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\u8001\u7237\u7237"
  rootNode:
    npcLines:
    - "\u8001\u7237\u7237:\n\u5E74\u8F7B\u4EBA\uFF01\u8BF7\u7559\u6B65\uFF01\u6C42\u4F60\u5E2E\u5E2E\u6211\uFF0C\u6211\u2026\u2026\u6211\u7684\u7389\u4F69\u4E0D\u89C1\u4E86\uFF01"
    - "\u6211:\n\u8001\u7237\u7237\u522B\u6025\uFF0C\u8FD9\u5730\u65B9\u8FD9\u4E48\u5927\uFF0C\u60A8\u8BB0\u5F97\u5927\u6982\u4E22\u5728\u54EA\u4E86\u5417\uFF1F"
    - "\u8001\u7237\u7237:\n\u90A3\u662F\u6211\u5BB6\u4F20\u7684\u7389\u4F69\u554A\uFF0C\u662F\u6211\u7237\u7237\u7559\u7ED9\u6211\u7684\u552F\u4E00\u5FF5\u60F3\uFF0C\u9752\u7EFF\u8272\u7684\uFF0C\u89E6\u624B\u6E29\u6DA6\uFF0C\u662F\u6211\u8D34\u8EAB\u6234\u4E86\u5341\u51E0\u5E74\u7684\u4E1C\u897F\u3002"
    - "\u6211:\n\u522B\u7740\u6025\uFF0C\u4F60\u6700\u540E\u4E00\u6B21\u770B\u5230\u7389\u4F69\u662F\u5728\u4EC0\u4E48\u65F6\u5019\uFF1F\u5728\u54EA\u91CC\uFF1F"
    - "\u8001\u7237\u7237:\n\u6211\u5C31\u5728\u8FD9\u9644\u8FD1\u901B\u4E86\u4E00\u4E0B,\u53EF\u80FD\u5C31\u4E22\u5728\u8FD9\u9644\u8FD1\u5427,\u4F46\u662F\u6211\u7684\u773C\u795E\u4E0D\u592A\u597D,\u53EF\u4EE5\u6073\u6C42\u4F60\u5E2E\u5E2E\u6211\u5417"
    - "\u6211:\n\u653E\u5FC3\uFF0C\u6211\u5E2E\u4F60\u53BB\u627E\u627E\uFF0C\u4E00\u5B9A\u4F1A\u5E2E\u4F60\u627E\u56DE\u6765\u7684\u3002"
    choices: []
    onNodeTriggerEvent:
      m_PersistentCalls:
        m_Calls: []
  alternateNodes:
  - npcLines:
    - "\u8FD9\u2026\u2026\u8FD9\u5C31\u662F\u6211\u7684\u7389\u4F69\uFF01\u6CA1\u9519\uFF0C\u5C31\u662F\u5B83\uFF01\u592A\u597D\u4E86\uFF0C\u7EC8\u4E8E\u627E\u56DE\u6765\u4E86\uFF01\u592A\u8C22\u8C22\u4F60\u4E86\uFF0C\u5E74\u8F7B\u4EBA\uFF01"
    - "\u6211\uFF1A\u4E0D\u5BA2\u6C14\uFF0C\u80FD\u5E2E\u5230\u4F60\u6211\u4E5F\u5F88\u5F00\u5FC3\u3002\u8001\u7237\u7237\uFF0C\u4F60\u80FD\u8DDF\u6211\u8BF4\u8BF4\u8FD9\u7389\u4F69\u7684\u6545\u4E8B\u5417\uFF1F\u5B83\u770B\u8D77\u6765\u6709\u4E9B\u5E74\u5934\u4E86\u3002"
    - "\u8FD9\u5757\u7389\u4F69\uFF0C\u662F\u6211\u7237\u7237\u7684\u7237\u7237\u4F20\u4E0B\u6765\u7684\uFF0C\u89C1\u8BC1\u4E86\u8FD9\u7948\u5E74\u6BBF\u4ECE\u70E7\u6BC1\u5230\u91CD\u751F\u7684\u767E\u5E74\u6CA7\u6851\u3002\r\n\u4F60\u62AC\u5934\u770B\u2014\u2014\u8FD9\u7948\u5E74\u6BBF\uFF0C\u5706\u5F62\u7684\u6BBF\u8EAB\u3001\u5706\u5F62\u7684\u5C4B\u9876\u3001\u5706\u5F62\u7684\u53F0\u9636\uFF0C\u8FD9\u5C31\u662F\u2018\u5929\u5706\u5730\u65B9\u2019\u3002"
    - "\u6211\uFF1A\u539F\u6765\u662F\u8FD9\u6837\u2026\u2026\u8FD9\u6BBF\u771F\u7684\u8D8A\u770B\u8D8A\u4E0D\u7B80\u5355\u3002"
    - "\u4F60\u770B\u90A3\u4E09\u5C42\u84DD\u8272\u7684\u7409\u7483\u74E6\uFF0C\u4E00\u5C42\u6BD4\u4E00\u5C42\u6536\u62E2\uFF0C\u8C61\u5F81\u7740\u5929\u7A79\u7684\u6DF1\u8FDC\u3002\u8FD8\u6709\u90A3\u6BBF\u6A90\u4E0B\u7684\u6597\u62F1\uFF0C\u5C42\u5C42\u53E0\u53E0\uFF0C\u4E0D\u7528\u4E00\u9897\u94C1\u9489\uFF0C\u5168\u9760\u6728\u5934\u54AC\u5408\u2014\u2014\u8FD9\u624D\u662F\u8001\u7956\u5B97\u7684\u667A\u6167\u3002"
    - "\u6211\uFF1A\u90A3\u5F53\u5E74\u90A3\u573A\u5927\u706B\uFF0C\u662F\u600E\u4E48\u70E7\u8D77\u6765\u7684\uFF1F"
    - "\u5149\u7EEA\u5341\u4E94\u5E74\uFF081889\u5E74\uFF09\uFF0C\u96F7\u51FB\u8D77\u706B\uFF0C\u6728\u8D28\u5927\u6BBF\u70E7\u4E86\u6574\u6574\u4E00\u591C\u3002\u540E\u6765\u5149\u7EEA\u5E1D\u547D\u4EBA\u6309\u539F\u6837\u91CD\u5EFA\u3002\u73B0\u5728\u4F60\u770B\u5230\u7684\uFF0C\u662F1896\u5E74\u624D\u5B8C\u5DE5\u7684\u91CD\u5EFA\u6BBF\u3002\u6211\u7956\u4E0A\u5C31\u662F\u5F53\u5E74\u53C2\u4E0E\u91CD\u5EFA\u7684\u6728\u5320\uFF0C\u8FD9\u5757\u7389\u4F69\uFF0C\u5C31\u662F\u4ED6\u7559\u5728\u6BBF\u57FA\u4E0B\u7948\u798F\u7528\u7684\u3002"
    - "\u6211\uFF1A\u96BE\u602A\u60A8\u8FD9\u4E48\u7740\u6025\u627E\u56DE\u6765\u2026\u2026\u8FD9\u4E0D\u662F\u666E\u901A\u7684\u7389\u4F69\uFF0C\u662F\u60A8\u5BB6\u65CF\u7684\u6839\u3002"
    - "\u662F\u554A\u3002\u6BBF\u91CC\u7684\u90A3\u56DB\u6839\u9F99\u4E95\u67F1\uFF0C\u4EE3\u8868\u4E00\u5E74\u56DB\u5B63\uFF1B\u5341\u4E8C\u6839\u91D1\u67F1\u4EE3\u8868\u5341\u4E8C\u4E2A\u6708\uFF1B\u5341\u4E8C\u6839\u6A90\u67F1\u4EE3\u8868\u5341\u4E8C\u4E2A\u65F6\u8FB0\u2014\u2014\u52A0\u8D77\u6765\u5C31\u662F\u4E00\u5929\u3001\u4E00\u6708\u3001\u4E00\u5E74\uFF0C\u5468\u800C\u590D\u59CB\uFF0C\u751F\u751F\u4E0D\u606F\u3002\r\n\u6211\u7237\u7237\u5E38\u8BF4\uFF0C\u8FD9\u6BBF\u91CC\u7684\u6BCF\u4E00\u6839\u67F1\u5B50\uFF0C\u90FD\u6709\u5DE5\u5320\u7684\u9B42\u3002\u6211\u8FD9\u5757\u7389\u4F69\uFF0C\u4E5F\u6CBE\u4E86\u90A3\u4EFD\u9B42\u3002"
    - "\u6211\uFF1A\u542C\u60A8\u8FD9\u4E48\u4E00\u8BF4\uFF0C\u6211\u518D\u770B\u8FD9\u7948\u5E74\u6BBF\uFF0C\u611F\u89C9\u5B8C\u5168\u4E0D\u4E00\u6837\u4E86\u3002"
    - "\u597D\u5566\uFF0C\u597D\u5B69\u5B50\uFF0C\u4ECA\u5929\u8C22\u8C22\u4F60\u4E86\u3002\u4F60\u53EF\u4EE5\u968F\u4FBF\u901B\u901B"
    - "\u6211\uFF1A\u597D\u7684\uFF0C\u8C22\u8C22\u8001\u7237\u7237\uFF01\u60A8\u4FDD\u91CD\u8EAB\u4F53\uFF0C\u62DC\u62DC\uFF01"
    - "\u62DC\u62DC\uFF0C\u5B69\u5B50\u3002\u613F\u4F60\u8FD9\u4E00\u5E74\uFF0C\u4E94\u8C37\u4E30\u767B\uFF0C\u5E73\u5B89\u987A\u9042\u3002"
    choices: []
