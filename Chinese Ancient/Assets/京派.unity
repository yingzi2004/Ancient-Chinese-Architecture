  m_Script: {fileID: 11500000, guid: b6e59408ea7124447bdd77c4ded7615a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\u6309L\u952E\u7EE7\u7EED         \u5C0F\u8C37"
  greetingText: "\u4F60\u597D\u5440,\u6211\u662F\u5C0F\u8C37,\u6B22\u8FCE\u6765\u5230\u7948\u5E74\u6BBF,\u4F60\u6709\u4EC0\u4E48\u60F3\u4E86\u89E3\u7684\u5417"
  useAutoDialogue: 1
  autoDialogueSequence:
  - "\u80FD\u4ECB\u7ECD\u4E00\u4E0B\u7948\u5E74\u6BBF\u5417"
  - "\u597D\u5440,\u7948\u5E74\u6BBF\u662F\u660E\u6E05\u4E24\u4EE3\u7687\u5E1D\u796D\u5929\u3001\u7948\u8C37\u7684\u795E\u5723\u573A\u6240\uFF0C\u5EFA\u4E8E\u660E\u6C38\u4E50\u5341\u516B\u5E74\uFF0C\u5DF2\u6709600\u591A\u5E74\u5386\u53F2\u4E86\u3002\u4F60\u770B\u8FD9\u5B8F\u4F1F\u7684\u5EFA\u7B51\uFF0C\u76F4\u5F8432\u7C73\uFF0C\u9AD838\u7C73\uFF0C\u5168\u90E8\u91C7\u7528\u6728\u8D28\u7ED3\u6784\uFF0C\u6CA1\u7528\u4E00\u9897\u9489\u5B50\uFF01"
  - "\u54C7\u585E,\u597D\u5389\u5BB3\u554A"
  - "\u5F53\u7136\u5566,\u8FD8\u6709\u6BBF\u5185\u768428\u6839\u6960\u6728\u5927\u67F1\u4E5F\u5404\u6709\u5BD3\u610F\u2014\u2014\u4E2D\u95F44\u6839\u9F99\u4E95\u67F1\u4EE3\u8868\u4E00\u5E74\u56DB\u5B63\uFF0C\u4E2D\u570812\u6839\u8C61\u5F81\u5341\u4E8C\u4E2A\u6708\uFF0C\u5916\u570812\u6839\u5BF9\u5E94\u5341\u4E8C\u65F6\u8FB0\uFF0C\u52A0\u8D77\u6765\u6070\u597D\u662F28\u661F\u5BBF\uFF0C\u662F\u4E0D\u662F\u5F88\u795E\u5947"
  - "\u592A\u795E\u5947\u4E86\uFF0C\u602A\u4E0D\u5F97\u8BF4\u5B83\u662F\u53E4\u4EE3\u796D\u5929\u7684\u5730\u65B9\u3002\u90A3\u53E4\u4EE3\u7687\u5E1D\u6765\u8FD9\u513F\uFF0C\u4E3B\u8981\u662F\u505A\u4EC0\u4E48\u5440\uFF1F"
  - "\u4E3B\u8981\u662F\u7948\u8C37\uFF0C\u5C31\u662F\u7948\u6C42\u6765\u5E74\u98CE\u8C03\u96E8\u987A\u3001\u4E94\u8C37\u4E30\u767B\uFF0C\u6BD5\u7ADF\u53E4\u4EE3\u4EE5\u519C\u4E3A\u672C\uFF0C\u8FD9\u53EF\u662F\u5929\u5927\u7684\u4E8B\u3002\u800C\u4E14\u542C\u8BF4\uFF0C\u8FD9\u91CC\u4E3E\u884C\u796D\u7940\u5927\u5178\u7684\u65F6\u5019\uFF0C\u4EEA\u5F0F\u7279\u522B\u9686\u91CD\u3002"
