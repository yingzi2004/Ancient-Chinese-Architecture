  - {fileID: 21300000, guid: 75a90b6bb3626cb4b92d356d1538e904, type: 3}
  - {fileID: 21300000, guid: d86bbc0b2e35bee41850cc1b59ee7a2d, type: 3}
  - {fileID: 0}
  dialogueLines:
  - "\u8001\u7237\u7237:\n\u5E74\u8F7B\u4EBA\uFF01\u8BF7\u7559\u6B65\uFF01\u6C42\u4F60\u5E2E\u5E2E\u6211\uFF0C\u6211\u2026\u2026\u6211\u7684\u7389\u4F69\u4E0D\u89C1\u4E86\uFF01"
  - "\u6211:\n\u7389\u4F69\uFF1F\u4EC0\u4E48\u7389\u4F69\uFF1F\u6162\u6162\u8BF4\uFF0C\u6211\u6216\u8BB8\u80FD\u5E2E\u4F60\u3002"
  - "\u8001\u7237\u7237:\n\u90A3\u662F\u6211\u5BB6\u4F20\u7684\u7389\u4F69\u554A\uFF0C\u662F\u6211\u6BCD\u4EB2\u7559\u7ED9\u6211\u7684\u552F\u4E00\u5FF5\u60F3\uFF0C\u9752\u7EFF\u8272\u7684\uFF0C\u89E6\u624B\u6E29\u6DA6\uFF0C\u662F\u6211\u8D34\u8EAB\u6234\u4E86\u5341\u51E0\u5E74\u7684\u4E1C\u897F\u3002"
  - "\u6211:\n\u522B\u7740\u6025\uFF0C\u4F60\u6700\u540E\u4E00\u6B21\u770B\u5230\u7389\u4F69\u662F\u5728\u4EC0\u4E48\u65F6\u5019\uFF1F\u5728\u54EA\u91CC\uFF1F"
