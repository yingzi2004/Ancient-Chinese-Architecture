  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d7f3758a5a54154c8cb7b69ac03a5b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerDelay: 0.5
  triggerOnce: 1
  guideName: "\u6C11\u4FD7\u5C55\u89C8\u8BB2\u89E3\u5458"
  guidePortrait: {fileID: 21300000, guid: 7cfd1018251d399469511d7a8a8d5a04, type: 3}
  expressionPortraits: []
  welcomeDialogue:
  - "\u6B22\u8FCE\u6765\u5230\u6C11\u4FD7\u6587\u5316\u5C55\u89C8\u9986\uFF01"
  - "\u8FD9\u91CC\u5C55\u793A\u4E86\u4E2D\u56FD\u4E30\u5BCC\u591A\u5F69\u7684\u6C11\u4FD7\u6587\u5316\uFF0C\u5305\u62EC\u4F20\u7EDF\u5EFA\u7B51\u3001\u751F\u6D3B\u7528\u5177\u3001\u6587\u5316\u4E60\u4FD7\u7B49\u3002"
  - "\u60A8\u53EF\u4EE5\u81EA\u7531\u53C2\u89C2\u5404\u4E2A\u5C55\u533A\uFF0C\u4E86\u89E3\u4E0D\u540C\u5730\u533A\u7684\u6C11\u4FD7\u7279\u8272\u3002"
  - "\u6309 L \u952E\u53EF\u4EE5\u63A8\u8FDB\u5BF9\u8BDD\uFF0C\u795D\u60A8\u53C2\u89C2\u6109\u5FEB\uFF01"
  highlightKeywords: []
  highlightColor: {r: 1, g: 0.84, b: 0, a: 1}
--- !u!114 &1139947597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1139947594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9b519bef13f851e498ea3de1c5e8e5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerOnce: 1
  triggerDelay: 0.3
  npcDisplayName: "\u6309L\u952E\u7EE7\u7EED  \u5C0F\u5FAE"
  portraitSprite: {fileID: 21300000, guid: d0675f73109c3e4498154f48a6726c41, type: 3}
  expressionPortraits:
  - {fileID: 0}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
  - {fileID: 21300000, guid: d110b26242fd17e4abba588f56c59f6a, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 75a90b6bb3626cb4b92d356d1538e904, type: 3}
  - {fileID: 21300000, guid: d86bbc0b2e35bee41850cc1b59ee7a2d, type: 3}
  - {fileID: 0}
  dialogueLines:
  - "\u5BA2\u5B98\uFF0C\u4F60\u77A7\u8FD9\u9999\u7089\u2014\u2014\u53E4\u65F6\u5019\u5440\uFF0C\u5929\u575B\u8FD9\u5730\u65B9\u53EF\u4E0D\u662F\u968F\u4FBF\u80FD\u8FDB\u6765\u7684\u3002\u6BCF\u5E74\u51AC\u81F3\uFF0C\u7687\u4E0A\u4EB2\u81EA\u9886\u7740\u6587\u6B66\u767E\u5B98\uFF0C\u5728\u8FD9\u575B\u4E0A\u711A\u9999\u796D\u5929\uFF0C\u6C42\u7684\u662F\u98CE\u8C03\u96E8\u987A\u3001\u4E94\u8C37\u4E30\u767B\u3001\u56FD\u6CF0\u6C11\u5B89\u3002"
  - "\u90A3\u4E00\u70B7\u9999\u71C3\u8D77\u6765\uFF0C\u9752\u70DF\u8885\u8885\u5F80\u5929\u4E0A\u8D70\uFF0C\u50CF\u662F\u628A\u4EBA\u95F4\u7684\u7948\u613F\uFF0C\u4E00\u5B57\u4E00\u53E5\u8BF4\u7ED9\u5929\u8001\u7237\u542C\u3002"
  - "\u6240\u4EE5\u8FD9\u70E7\u9999\u7948\u798F\u5440\uFF0C\u8BB2\u7A76\u7684\u5C31\u662F\u4E00\u4E2A\u2018\u8BDA\u2019\u5B57\u3002\u5FC3\u8BDA\u4E86\uFF0C\u9999\u706B\u81EA\u7136\u5C31\u65FA\u4E86\u3002\r\n"
