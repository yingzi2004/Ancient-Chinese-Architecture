  m_text: "\u7948\u5E74\u6BBF\u7684\u5185\u90E8\u7ED3\u6784\u53EF\u4EE5\u8BF4\u662F\u53E4\u4EE3\u5EFA\u7B51\u7684\u4E00\u4E2A\u7CBE\u5DE7\u6770\u4F5C\u3002\r\n\u5B83\u6700\u6838\u5FC3\u7684\u662F\u56DB\u6839
    \u201C\u9F99\u4E95\u67F1\u201D\uFF0C\u8C61\u5F81\u56DB\u5B63\uFF0C\u652F\u6491\u7740\u6700\u4E0A\u5C42\u7684\u5C4B\u9876\u3002\u4E2D\u95F4\u4E00\u5708\u662F\u5341\u4E8C\u6839
    \u201C\u91D1\u67F1\u201D\uFF0C\u4EE3\u8868\u5341\u4E8C\u4E2A\u6708\u3002\u6700\u5916\u5C42\u8FD8\u6709\u5341\u4E8C\u6839
    \u201C\u6A90\u67F1\u201D\uFF0C\u5BF9\u5E94\u4E00\u5929\u7684\u5341\u4E8C\u4E2A\u65F6\u8FB0\u3002\u5185\u5916\u67F1\u5B50\u76F8\u52A0\u5171\u4E8C\u5341\u516B\u6839\uFF0C\u53C8\u6697\u542B\u5929\u4E0A\u7684\u4E8C\u5341\u516B\u661F\u5BBF\u3002\r\n\u6BBF\u5185\u9876\u90E8\u662F\u534E\u4E3D\u7684\u5706\u5F62\u85FB\u4E95\uFF0C\u5C42\u5C42\u5411\u4E0A\u6536\u7F29\uFF0C\u6781\u5177\u89C6\u89C9\u51B2\u51FB\u529B\u3002\u6B63\u4E2D\u592E\u8BBE\u6709\u5B9D\u5EA7\uFF0C\u662F\u4E3E\u884C\u796D\u7940\u4EEA\u5F0F\u7684\u6838\u5FC3\u533A\u57DF\u3002\u6574\u4E2A\u7ED3\u6784\u4E0D\u7528\u4E00\u6839\u9489\u5B50\uFF0C\u5168\u9760\u69AB\u536F\u54AC\u5408\uFF0C\u4E09\u5C42\u5C4B\u6A90\u5C42\u5C42\u53E0\u53E0\uFF0C\u4ECE\u5185\u5230\u5916\u90FD\u900F\u7740\u53E4\u4EBA\u5BF9\u5929\u5730\u5B87\u5B99\u7684\u7CBE\u5999\u7406\u89E3\u3002"
