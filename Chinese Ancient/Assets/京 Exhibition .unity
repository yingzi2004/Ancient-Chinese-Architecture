--- !u!114 &816178827
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 816178823}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 31a41915fe269ee488049a7269a29a7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayText: {fileID: 253339946}
  introPanel: {fileID: 202010748}
  closeButton: {fileID: 2075575415}
  hoverColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  paragraphs:
  - "\u7948\u5E74\u6BBF\u524D\u8EAB\u201C\u5927\u7940\u6BBF\u201D\uFF0C\u662F\u5317\u4EAC\u5929\u575B\u7684\u4E3B\u4F53\u5EFA\u7B51\uFF0C\u53C8\u79F0\u7948\u8C37\u6BBF\uFF0C\u662F\u660E\u6E05\u4E24\u4EE3\u7687\u5E1D\u5B5F\u6625\u7948\u8C37\u4E4B\u6240\uFF0C\u662F\u53E4\u4EE3\u660E\u5802\u5F0F\u5EFA\u7B51\u4EC5\u5B58\u7684\u4E00\u4F8B\u3002\u7948\u5E74\u6BBF\u4F4D\u4E8E\u5317\u4EAC\u5E02\u4E1C\u57CE\u533A\u5929\u575B\u4E1C\u8DEF\u3002\r\n\u7948\u5E74\u6BBF\u59CB\u5EFA\u4E8E\u660E\u6C38\u4E50\u5341\u516B\u5E74\uFF0C\u6E05\u5149\u7EEA\u5341\u4E94\u5E749\u670818\u65E5\u711A\u6BC1\u4E8E\u96F7\u706B\uFF0C\u6B21\u5E74\u91CD\u5EFA\u5E76\u4E8E1896\u5E74\u5B8C\u5DE5\u30021970\u5E7410\u6708\u81F31971\u5E749\u6708\uFF0C\u7948\u5E74\u6BBF\u6309\u96F7\u706B\u711A\u6BC1\u524D\u91CD\u65B0\u4FEE\u5EFA\u3002"
  - "\u7948\u5E74\u6BBF\u5927\u6BBF\u9762\u79EF460\u5E73\u65B9\u7C73\uFF0C\u662F\u4E00\u5EA7\u91D1\u78A7\u5B9D\u9876\u3001\u84DD\u74E6\u7EA2\u67F1\u3001\u91D1\u78A7\u8F89\u714C\u7684\u5F69\u7ED8\u4E09\u5C42\u91CD\u6A90\u5706\u5F62\u5927\u6BBF\u3002\u7948\u5E74\u6BBF\u91C7\u7528\u7684\u662F\u4E0A\u6BBF\u4E0B\u5C4B\u7684\u6784\u9020\u5F62\u5F0F
    \uFF0C\u53C2\u8003\u4E86\u6B66\u5219\u5929\u6240\u5EFA\u6D1B\u9633\u660E\u5802\u4E0A\u5706\u4EE5\u6CD5\u5929\u3001\u53F0\u57FA\u65B9\u4EE5\u6CD5\u5730\u3001\u6CD5\u5341\u4E8C\u65F6\u8FB0\u3001\u4E8C\u5341\u56DB\u8282\u6C14\u7B49\u57FA\u672C\u8981\u70B9\uFF0C\u662F\u6B66\u5219\u5929\u660E\u5802\u6700\u91CD\u8981\u7684\u7EE7\u627F\u6027\u5EFA\u7B51\u3002
    \u5B83\u6309\u7167\u201C\u656C\u5929\u793C\u795E\u201D\u7684\u601D\u60F3\u8BBE\u8BA1\uFF0C\u6BBF\u4E3A\u5706\u5F62\uFF0C\u8C61\u5F81\u5929\u5706\uFF1B\u74E6\u4E3A\u84DD\u8272\uFF0C\u8C61\u5F81\u84DD\u5929\u3002\u8FD9\u79CD\u8BBE\u8BA1\u53D7\u5230\u4E86\u201C\u5929\u84DD\u5730\u9EC4\u201D\u4F20\u7EDF\u89C2\u5FF5\u7684\u5F71\u54CD\u3002
    \u7948\u5E74\u6BBF\u72EC\u7279\u7684\u7ED3\u6784\u7279\u5F81\u4F7F\u5F97\u8FD9\u79CD\u5F62\u5F0F\u7684\u4EFF\u53E4\u5EFA\u7B51\u7ED3\u6784\u6027\u80FD\u4E0E\u5176\u73B0\u4EE3\u5EFA\u7B51\u6709\u6240\u4E0D\u540C\uFF0C\u5E76\u4E3A\u4ECA\u540E\u4EFF\u53E4\u5EFA\u7B51\u8FDB\u4E00\u6B65\u7814\u7A76\u63D0\u4F9B\u4E86\u601D\u8DEF\u3002"
  - "\u7948\u5E74\u6BBF\u7684\u5386\u53F2\u548C\u6587\u5316\u80CC\u666F\u4F7F\u5176\u6210\u4E3A\u4E2D\u56FD\u91CD\u8981\u7684\u6587\u5316\u9057\u4EA7\u4E4B\u4E00\uFF0C1961\u5E74\u88AB\u5217\u4E3A\u5168\u56FD\u91CD\u70B9\u6587\u7269\u4FDD\u62A4\u5355\u4F4D\u3002"
  typingSpeed: 0.05
  displayDuration: 2.5
