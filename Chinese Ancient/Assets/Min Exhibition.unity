  m_text: "\u4E09\u5C3A\u620F\u53F0\u85CF\u5929\u5730\uFF0C\u5341\u6307\u63D0\u7EBF\u821E\u4E7E\u5764\uFF0C\u8FD9\u95E8\u6D41\u6DCC\u516D\u767E\u4F59\u5E74\u7684\u827A\u672F\uFF0C\u4EE5\u6728\u5076\u4E3A\u5A92\u3001\u4E1D\u7EBF\u4E3A\u9B42\uFF0C\u827A\u4EBA\u6307\u5C16\u7FFB\u98DE\u95F4\uFF0C\u5080\u5121\u4FBF\u6709\u4E86\u7709\u773C\u98CE\u9AA8\uFF0C\u5728\u65B9\u5BF8\u4E4B\u4E0A\u6F14\u7ECE\u5343\u5E74\u60B2\u6B22\uFF0C\u627F\u8F7D\u7740\u5BA2\u5BB6\u4EBA\u6700\u6DF1\u6C89\u7684\u60C5\u6000\u3002\r\n2021\u5E74\uFF0C\u95FD\u897F\u5BA2\u5BB6\u6728\u5076\u620F\u6B63\u5F0F\u5165\u9009\u7B2C\u4E94\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u540D\u5F55\uFF0C\u8FD9\u4EFD\u8DE8\u8D8A\u516D\u767E\u5E74\u7684\u575A\u5B88\uFF0C\u7EC8\u4E8E\u88AB\u954C\u523B\u5728\u56FD\u5BB6\u7EA7\u975E\u9057\u7684\u53F2\u518C\u4E4B\u4E0A\u3002\u8FD9\u95E8\u53E4\u8001\u827A\u672F\uFF0C\u66F4\u5728\u571F\u5730\u9769\u547D\u65F6\u671F\uFF0C\u4E66\u5199\u4E86\u4E00\u6BB5\u70ED\u8840\u6CB8\u817E\u7684\u7EA2\u8272\u4F20\u5947\u2014\u2014\u6728\u5076\u827A\u4EBA\u4E18\u5FC5\u4E66\u3001\u5F90\u4F20\u534E\u7B49\u4EBA\uFF0C\u4EE5\u620F\u4E3A\u5203\u3001\u4EE5\u827A\u4E3A\u6865\uFF0C\u7F16\u6F14\u300A\u6253\u571F\u8C6A\u300B\u300A\u6269\u5927\u7EA2\u519B\u300B\u7B49\u5267\u76EE\uFF0C\u5728\u620F\u53F0\u4E4B\u4E0A\u4F20\u9012\u9769\u547D\u706B\u79CD\uFF0C\u66F4\u501F\u6F14\u51FA\u4E4B\u4FBF\uFF0C\u5C06\u60C5\u62A5\u85CF\u4E8E\u6728\u5076\u8863\u7F1D\u3001\u5C06\u7269\u8D44\u85CF\u4E8E\u620F\u7BB1\uFF0C\u7528\u5320\u5FC3\u4E0E\u5FE0\u8BDA\uFF0C\u5B88\u62A4\u7740\u9769\u547D\u5E0C\u671B\u3002\r\n\u95FD\u897F\u5BA2\u5BB6\u6728\u5076\u620F\uFF0C\u662F\u6307\u5C16\u7684\u7EDD\u827A\uFF0C\u662F\u5BA2\u5BB6\u7684\u9B42\u97F5\uFF0C\u662F\u516D\u767E\u5E74\u65F6\u5149\u6C89\u6DC0\u7684\u975E\u9057\u7470\u5B9D\u3002\u5B83\u85CF\u7740\u95FD\u897F\u4EBA\u7684\u5320\u5FC3\u4E0E\u575A\u5B88\uFF0C\u85CF\u7740\u5BA2\u5BB6\u4EBA\u7684\u5BB6\u56FD\u4E0E\u60B2\u6B22\uFF0C\u85CF\u7740\u975E\u9057\u6