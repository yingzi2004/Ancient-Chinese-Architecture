  - {fileID: 21300000, guid: df6c9b5def95ef841bd0bd52472dde81, type: 3}
  - {fileID: 21300000, guid: df6c9b5def95ef841bd0bd52472dde81, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 20eb5e9df3eec9142a002eff85089f49, type: 3}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 21300000, guid: 20eb5e9df3eec9142a002eff85089f49, type: 3}
  - {fileID: 21300000, guid: 20eb5e9df3eec9142a002eff85089f49, type: 3}
  - {fileID: 0}
  - {fileID: 0}
  dialogueLines:
  - "\uFF08\u753B\u9762\u6E10\u4EAE\uFF0C\u571F\u697C\u573A\u9986\u7684\u9648\u8BBE\u6620\u5165\u773C\u5E18\u3002\u7AF9\u7F16\u3001\u592F\u571F\u5899\u3001\u95FD\u5357\u8001\u539D\u7684\u683C\u5C40\u2014\u2014\u7136\u540E\uFF0C\u4E00\u4E2A\u7A7F\u7740\u8D6D\u9EC4\u8863\u886B\u7684\u5C11\u5973\u4ECE\u5C55\u677F\u540E\u9762\u63A2\u51FA\u5934\u6765\uFF0C\u773C\u775B\u77AA\u5F97\u5706\u5706\u7684\u3002\uFF09"
  - "\u54A6\uFF1F"
  - "\uFF08\u5979\u5F80\u524D\u51D1\u4E86\u4E24\u6B65\uFF0C\u4ED4\u7EC6\u6253\u91CF\u4F60\uFF0C\u50CF\u5728\u786E\u8BA4\u4EC0\u4E48\u3002\uFF09"
  - " \u4F60\u2026\u2026\u4F60\u770B\u5F97\u89C1\u6211\uFF1F"
  - "\uFF08\u4F60\u70B9\u4E86\u70B9\u5934\u3002\u5979\u5012\u5438\u4E00\u53E3\u6C14\uFF0C\u8138\u4E0A\u7684\u8868\u60C5\u4ECE\u7591\u60D1\u53D8\u6210\u96BE\u4EE5\u7F6E\u4FE1\uFF0C\u53C8\u53D8\u6210\u85CF\u4E0D\u4F4F\u7684\u6B22\u559C\u3002\uFF09"
  - "\u771F\u7684\u662F\u5BA2\u4EBA\uFF01\u6D3B\u7684\uFF01\u4F1A\u52A8\u7684\uFF01\u80FD\u770B\u89C1\u6211\u7684\uFF01"
  - "\u54B3\uFF0C\u5931\u793C\u4E86\u5931\u793C\u4E86\u3002\u6211\u53EB\u5C0F\u5FAE\uFF0C\u89C1\u5FAE\u77E5\u8457\u7684\u5FAE\u2014\u2014\u662F\u4F4F\u5728\u8FD9\u53E4\u5377\u91CC\u7684\u5C0F\u5377\u7075\uFF01"
  - "\u597D\u4E45\u597D\u4E45\u6CA1\u4EBA\u80FD\u8D70\u8FDB\u8FD9\u5377\u91CC\u4E86\u3002\u4E0A\u56DE\u6709\u4EBA\u6765\u2026\u2026\u54CE\u5440\uFF0C\u8BB0\u4E0D\u6E05\u4E86\u3002\u53CD\u6B63\uFF0C\u5BA2\u5B98\u4F60\u662F\u88AB\u8FD9\u5377\u8F74\u9009\u4E2D\u7684\u4EBA\uFF01"
  - "\u5BA2\u5B98\u65B9\u624D\u78B0\u89E6\u4E86\u90A3\u5377\u8F74\u4E2D\u7684\u571F\u697C\uFF0C\u6240\u4EE5\u54B1\u4EEC\u5C31\u5148\u5230\u4E86\u8FD9\u513F\u2014\u2014\u798F\u5EFA\u571F\u697C\u7684\u5C55\u9986\u3002\u4F60\u77A7\u8FD9\u5E03\u7F6E\uFF0C\u592F\u571F\u5899\u3001\u7AF9\u7F16\u3001\u8001\u539D\u7684\u683C\u5C40\uFF0C\u662F\u4E0D\u662F\u5E26\u7740\u95FD\u5357\u5C71\u95F4\u7684\u5473\u9053\uFF1F"
  - "\u8FD9\u53E4\u5377\u91CC\u5440\uFF0C\u6536\u4E86\u56DB\u6D3E\u53E4\u5EFA\u7684\u6C14\u97F5\u3002\u4ECE\u5357\u8FB9\u7684\u571F\u697C\u5F00\u59CB\uFF0C\u5F80\u5317\u8D70\uFF0C\u8FD8\u6709\u82CF\u5DDE\u7684\u56ED\u6797\u3001\u5C71\u897F\u7684\u664B\u5546\u5927\u9662\uFF0C\u6700\u5317\u8FB9\u662F\u5317\u4EAC\u7684\u5929\u575B\u2014\u2014\u521A\u597D\u4E32\u6210\u4E00\u6761\u4ECE\u5357\u5230\u5317\u7684\u53E4\u5EFA\u8109\u7EDC\u3002"
  - "\u5BA2\u5B98\u65E2\u7136\u80FD\u8D70\u8FDB\u6765\uFF0C\u60F3\u5FC5\u5FC3\u91CC\u662F\u88C5\u7740\u8FD9\u4E9B\u8001\u623F\u5B50\u3001\u8001\u6728\u5934\u7684\u3002\u90A3\u8FD9\u8D9F\u53E4\u5EFA\u65C5\u7A0B\uFF0C\u5C31\u7531\u5C0F\u5FAE\u966A\u7740\u5BA2\u5B98\u8D70\uFF01"
  - "\u54B1\u4EEC\u5148\u4ECE\u8FD9\u5C55\u9986\u901B\u8D77\u3002\u5DE6\u624B\u8FB9\u662F\u571F\u697C\u7684\u5EFA\u7B51\u65F6\u95F4\u7EBF\uFF0C\u987A\u7740\u5B83\u6162\u6162\u77A7\uFF0C\u571F\u697C\u600E\u4E48\u6765\u7684\u3001\u600E\u4E48\u53D8\u7684\uFF0C\u4E00\u76EE\u4E86\u7136\u3002\u901B\u7740\u901B\u7740\uFF0C\u8BF4\u4E0D\u5B9A\u5C31\u80FD\u5BFB\u7740\u53BB\u771F\u6B63\u571F\u697C\u7684\u6CD5\u5B50\u5566"
  - "\u2014\u2014\u4E0D\u8FC7\u5C0F\u5FAE\u53EF\u4E0D\u4F1A\u76F4\u63A5\u544A\u8BC9\u4F60\uFF0C\u90A3\u5F97\u5BA2\u5B98\u81EA\u5DF1\u53D1\u73B0\u624D\u6709\u610F\u601D\uFF01\u597D\u5566\uFF0C\u5BA2\u5B98\u4E14\u6162\u6162\u770B\u3002\u5C0F\u5FAE\u5C31\u5728\u8FB9\u4E0A\uFF0C\u6709\u4E8B\u513F\u5524\u6211\u4FBF\u662F"
  highlightKeywords:
  - "\u5C0F\u5FAE"
  - "\u88AB\u5377\u8F74\u9009\u4E2D\u7684\u4EBA"
  - "\u56DB\u6D3E\u53E4\u5EFA"
  - "\u771F\u6B63\u571F\u697C"
  highlightColor: {r: 0.6167675, g: 0.75278187, b: 0.7924528, a: 1}
  locationName: "\u672A\u547D\u540D\u4F4D\u7F6E"
  portraitRevealIndex: 1
  nameRevealIndex: 7
