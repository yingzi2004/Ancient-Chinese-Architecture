  m_EditorClassIdentifier: 
  triggerOnce: 1
  triggerDelay: 0.3
  npcDisplayName: "\u6309L\u952E\u7EE7\u7EED  \u5C0F\u5FAE"
  portraitSprite: {fileID: 21300000, guid: ed6dc30c2dc67894b95e7ad48fef27fa, type: 3}
  expressionPortraits:
  - {fileID: 0}
  - {fileID: 21300000, guid: df6c9b5def95ef841bd0bd52472dde81, type: 3}
  - {fileID: 21300000, guid: df6c9b5def95ef841bd0bd52472dde81, type: 3}
  - {fileID: 21300000, guid: 20eb5e9df3eec9142a002eff85089f49, type: 3}
  dialogueLines:
  - "\u5440\uFF0C\u5BA2\u5B98\u8D70\u5230\u8FD9\u91CC\u5566\uFF01\u524D\u9762\u8FD9\u6247\u95E8\u540E\u5934\uFF0C\u53EF\u5C31\u662F\u771F\u6B63\u7684\u571F\u697C\u5566\u2014\u2014\u4E0D\u662F\u5C55\u677F\uFF0C\u4E0D\u662F\u6A21\u578B\uFF0C\u662F\u5B9E\u5B9E\u5728\u5728\u80FD\u8D70\u8FDB\u53BB\u7684\u90A3\u79CD\uFF01"
  - "\u4E0D\u8FC7\u8FD9\u95E8\u6709\u70B9\u513F\u53E4\u602A\uFF0C\u5B83\u8BA4\u7684\u662F\u4F60\u4EEC\u90A3\u4E2A\u4E16\u754C\u7684\u89C4\u77E9\u3002\u4F60\u5F97\u8D70\u5230\u95E8\u524D\uFF0C\u5BF9\u7740\u5B83\u6309\u4E00\u4E0B\u2026\u2026\u55EF\u2026\u2026\u90A3\u4E2A\u53EB
    \u2018\u8BF6\u7B26\u2019 \uFF08F) \u7684\u673A\u5173\u3002\n\uFF08\u5C0F\u5FAE\u6B6A\u6B6A\u5934\uFF0C\u4E00\u8138\u4E0D\u89E3\uFF09\n"
  - "\u597D\u5947\u602A\u7684\u540D\u5B57\u54E6\u2026\u2026\u4F60\u4EEC\u90A3\u8FB9\u559C\u6B22\u7ED9\u673A\u5173\u8D77\u8FD9\u79CD\u542C\u4E0D\u61C2\u7684\u4EE3\u53F7\u5417\uFF1F"
  - "\u7B97\u5566\u7B97\u5566\uFF0C\u53CD\u6B63\u5BA2\u5B98\u77E5\u9053\u5C31\u597D\u2014\u2014\u8D70\u5230\u95E8\u524D\uFF0C\u6309\u4E0B\u2018\u8BF6\u7B26\u2019\uFF0C\u54B1\u4EEC\u5C31\u571F\u697C\u89C1\uFF01
    \u91CC\u5934\u7684\u6881\u67F1\u69AB\u536F\u3001\u592F\u571F\u5899\u9762\uFF0C\u90FD\u7B49\u7740\u5BA2\u5B98\u53BB\u77A7\u5462\uFF01\n"
