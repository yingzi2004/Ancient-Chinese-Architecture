  m_text: "\u5386\u53F2\u89C1\u8BC1\u8005:\n\u7948\u5E74\u6BBF\u662F\u660E\u6C38\u4E50\u5341\u516B\u5E74\u5EFA\u6210\u7684\u660E\u6E05\u4E24\u4EE3\u7687\u5E1D\u7948\u6C42\u4E30\u6536\u7684\u91CD\u8981\u573A\u6240\u3002\u5B83\u81EA1420\u5E74\u5EFA\u6210\u4EE5\u6765,\u4FBF\u6210\u4E3A\u660E\u6E05\u4E24\u4EE3\u7687\u5E1D\u5B5F\u6625\u7948\u8C37\u7684\u4E13\u7528\u573A\u6240,\u89C1\u8BC1\u4E86\u7687\u5BB6\u796D\u7940\u6587\u5316\u7684\u53D1\u5C55\u548C\u4E2D\u56FD\u53E4\u4EE3\u5C01\u5EFA\u793C\u4EEA\u7684\u6F14\u53D8\u3002\u5B83\u9759\u9759\u7684\u89C1\u8BC1\u4E86\u4E2D\u56FD\u53E4\u4EE3\u5C01\u5EFA\u793C\u4EEA\u7684\u6F14\u53D8,\u6210\u4E3A\u4E86\u5386\u53F2\u7684\u89C1\u8BC1\u8005\u3002\n\n\"\u541B\u6743\u795E\u6388\"\u601D\u60F3:\n\u4F5C\u4E3A\u53E4\u4EE3\u7687\u5E1D\u4E0E\u4E0A\u5929\u6C9F\u901A\u7684\u795E\u5723\u6BBF\u5802,\u7948\u5E74\u6BBF\u901A\u8FC7\u5176\u72EC\u7279\u7684\u5EFA\u7B51\u89C4\u5236\u548C\u5E84\u91CD\u7684\u796D\u7940\u4EEA\u5F0F,\u4E0D\u65AD\u5F3A\u5316\u7687\u6743\u7684\u795E\u5723\u6027\u548C\u6743\u5A01\u6027\u3002\u5B83\u4E0D\u4EC5\u662F\"\u541B\u6743\u795E\u6388\"\u601D\u60F3\u7684\u91CD\u8981\u8C61\u5F81,\u66F4\u53CD\u6620\u4E86\u5F53\u65F6\u7684\u653F\u6CBB\u7406\u5FF5\u548C\u793E\u4F1A\u79E9\u5E8F\u3002\n\n\u72EC\u7279\u7684\u5EFA\u7B51\u98CE\u683C:\n\u7948\u5E74\u6BBF\u4EE5\u5706\u5F62\u5EFA\u7B51\u3001\u4E09\u91CD\u6A90\u8BBE\u8BA1\u4E0E\u5929\u5706\u5730\u65B9\n\u54F2\u5B66\u76F8\u547C\u5E94,\u5C55\u73B0\u51FA\u4E86\u72EC\u7279\u7684\u5EFA\u7B51\u827A\u672F\u9B45\u529B\u3002\u5176\u4E09\u91CD\u6A90\u5706\u6BBF\u7684\u8BBE\u8BA1,\u84DD\u8272\u7409\u7483\u74E6\u8986\u76D6,\u5728\u9633\u5149\u4E0B\u95EA\u95EA\u53D1\u5149\u3002"
