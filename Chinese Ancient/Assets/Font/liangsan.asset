    characterSetSelectionMode: 7
    characterSequence: "\u74E6\u732B\n\u571F\u697C\u5C4B\u810A\u4E0A\u7684\u5B88\u62A4\u795E\n\u2728
      \u795E\u517D\u804C\u5B88\n\u74E6\u732B\u662F\u6816\u606F\u5728\u798F\u5EFA\u571F\u697C\u4E0E\u95FD\u5357\u53E4\u539D\u5C4B\u9876\u4E0A\u7684\u795E\u517D\uFF0C\u4E13\u95E8\u8D1F\u8D23\u5728\u5C4B\u9876\u4E0A\u5F20\u5927\u773C\u775B\u3001\u864E\u89C6\u7708\u7708\uFF0C\u4ECE\u5C4B\u9876\u5230\u5899\u57FA\uFF0C\u90FD\u5728\u5B83\u5162\u5162\u4E1A\u4E1A\u7684\u5B88\u62A4\u8303\u56F4\u91CC\u3002\u770B\u5BB6\u62A4\u9662\u3001\u9547\u5B85\u8F9F\u90AA\uFF0C\u662F\u5B83\u4E0E\u751F\u4FF1\u6765\u7684\u8D23\u4EFB\u4E0E\u672C\u5206\u3002\u64C2\u8336\u662F\u5BA2\u5BB6\u4EBA\u4ECE\u4E2D\u539F\u5411\u5357\u65B9\u8FC1\u5F99\u4E2D\u7559\u4E0B\u7684\u5B9D\u8D35\u8D22\u5BCC\uFF0C\u662F\u5BA2\u5BB6\u4EBA\u6700\u666E\u901A\u4E5F\u662F\u6700\u9686\u91CD\u7684\u4E00\u79CD\u5F85\u5BA2\u793C\u4EEA\uFF0C\u5BA2\u5BB6\u64C2\u8336\u662F\u4FDD\u7559\u4E0B\u6765\u7684\u4E2D\u56FD\u6700\u53E4\u8001\u7684\u8336\u9053\u4E4B\u4E00\uFF0C\u88AB\u8A89\u4E3A\u201C\u4E2D\u56FD\u8336\u6587\u5316\u7684\u6D3B\u5316\u77F3\u201D\u3002\r\n\u5BA2\u5BB6\u64C2\u8336\u662F\u4F20\u7EDF\u7684\u98DF\u4FD7\u3002\u5BA2\u5BB6\u4EBA\u70ED\u60C5\u597D\u5BA2\uFF0C\u4EE5\u64C2\u8336\u5F85\u5BA2\u66F4\u662F\u4F20\u7EDF\u7684\u666E\u904D\u7684\u793C\u8282\u3002\u64C2\u8336\u6709\u4E00\u5957\u79F0\u4E3A\u201C\u64C2\u8336\u4E09\u5B9D\u201D\u7684\u5DE5\u5177\uFF1A\u4E00\u662F\u53E3\u5F8450\u5398\u7C73\u4E14\u5185\u58C1\u6709\u7C97\u5BC6\u6C9F\u7EB9\u7684\u9676\u5236\u64C2\u94B5\uFF1B\u4E8C\u662F\u7528\u4E0A\u7B49\u5C71\u6942\u6728\u6216\u6CB9\u8336\u6811\u5E72\u52A0\u5DE5\u5236\u6210\u7684\u7EA685\u5398\u7C73\u957F\u7684\u64C2\u68CD\uFF1B\u4E09\u662F\u7528\u7AF9\u7BFE\u5236\u6210\u7684\u635E\u6EE4\u788E\u6E23\u7684\u201C\u635E\u5B50\u201D\u3002\r\n\u5236\u4F5C\u65F6\uFF0C\u5148\u5C06\u6240\u914D\u7F6E\u597D\u7684\u6750\u6599\uFF0C\u6309\u6BD4\u4F8B\u653E\u7F6E\u64C2\u94B5\u5185\uFF0C\u7528\u64C2\u6775\u6CBF\u94B5\u5185\u58C1\u9006\u6C9F\u7EB9\u8D70\u5411\u9891\u9891\u8202\u6363\u3001\u65CB\u8F6C\u78E8\u6210\u8336\u6CE5\u3002\u5BA2\u5BB6\u64C2\u8336\u65E2\u6709\u8336\u53F6\u7684\u7518\u5473\uFF0C\u829D\u9EBB\u3001\u82B1\u751F\u3001\u8C46\u5B50\u7684\u6E05\u9999\uFF0C\u4E5F\u6709\u751F\u59DC\u7684\u8FA3\u5473\uFF0C\u82E5\u518D\u4F50\u4EE5\u7092\u7C73\u3001\u82B1\u751F\u7C73\u3001\u8C46\u74E3\u3001\u7C73\u679C\u3001\u70EB\u76AE\u7B49\uFF0C\u4E00\u684C\u96C6\u9999\u3001\u751C\u3001\u8106\u3001\u8FA3\u4E8E\u4E00\u4F53\u7684\u5BA2\u5BB6\u64C2\u8336\u5BB4\u4FBF\u5E94\u8FD0\u800C\u751F\u4E86\u3002\n\U0001F3AD
      \u9020\u578B\u5BD3\u610F\u64C2\u8336\u662F\u5BA2\u5BB6\u4EBA\u4ECE\u4E2D\u539F\u5411\u5357\u65B9\u8FC1\u5F99\u4E2D\u7559\u4E0B\u7684\u5B9D\u8D35\u8D22\u5BCC\uFF0C\u662F\u5BA2\u5BB6\u4EBA\u6700\u666E\u901A\u4E5F\u662F\u6700\u9686\u91CD\u7684\u4E00\u79CD\u5F85\u5BA2\u793C\u4EEA\uFF0C\u5BA2\u5BB6\u64C2\u8336\u662F\u4FDD\u7559\u4E0B\u6765\u7684\u4E2D\u56FD\u6700\u53E4\u8001\u7684\u8336\u9053\u4E4B\u4E00\uFF0C\u88AB\u8A89\u4E3A\u201C\u4E2D\u56FD\u8336\u6587\u5316\u7684\u6D3B\u5316\u77F3\u201D\u3002\r\n\u5BA2\u5BB6\u64C2\u8336\u662F\u4F20\u7EDF\u7684\u98DF\u4FD7\u3002\u5BA2\u5BB6\u4EBA\u70ED\u60C5\u597D\u5BA2\uFF0C\u4EE5\u64C2\u8336\u5F85\u5BA2\u66F4\u662F\u4F20\u7EDF\u7684\u666E\u904D\u7684\u793C\u8282\u3002\u64C2\u8336\u6709\u4E00\u5957\u79F0\u4E3A\u201C\u64C2\u8336\u4E09\u5B9D\u201D\u7684\u5DE5\u5177\uFF1A\u4E00\u662F\u53E3\u5F8450\u5398\u7C73\u4E14\u5185\u58C1\u6709\u7C97\u5BC6\u6C9F\u7EB9\u7684\u9676\u5236\u64C2\u94B5\uFF1B\u4E8C\u662F\u7528\u4E0A\u7B49\u5C71\u6942\u6728\u6216\u6CB9\u8336\u6811\u5E72\u52A0\u5DE5\u5236\u6210\u7684\u7EA685\u5398\u7C73\u957F\u7684\u64C2\u68CD\uFF1B\u4E09\u662F\u7528\u7AF9\u7BFE\u5236\u6210\u7684\u635E\u6EE4\u788E\u6E23\u7684\u201C\u635E\u5B50\u201D\u3002\r\n\u5236\u4F5C\u65F6\uFF0C\u5148\u5C06\u6240\u914D\u7F6E\u597D\u7684\u6750\u6599\uFF0C\u6309\u6BD4\u4F8B\u653E\u7F6E\u64C2\u94B5\u5185\uFF0C\u7528\u64C2\u6775\u6CBF\u94B5\u5185\u58C1\u9006\u6C9F\u7EB9\u8D70\u5411\u9891\u9891\u8202\u6363\u3001\u65CB\u8F6C\u78E8\u6210\u8336\u6CE5\u3002\u5BA2\u5BB6\u64C2\u8336\u65E2\u6709\u8336\u53F6\u7684\u7518\u5473\uFF0C\u829D\u9EBB\u3001\u82B1\u751F\u3001\u8C46\u5B50\u7684\u6E05\u9999\uFF0C\u4E5F\u6709\u751F\u59DC\u7684\u8FA3\u5473\uFF0C\u82E5\u518D\u4F50\u4EE5\u7092\u7C73\u3001\u82B1\u751F\u7C73\u3001\u8C46\u74E3\u3001\u7C73\u679C\u3001\u70EB\u76AE\u7B49\uFF0C\u4E00\u684C\u96C6\u9999\u3001\u751C\u3001\u8106\u3001\u8FA3\u4E8E\u4E00\u4F53\u7684\u5BA2\u5BB6\u64C2\u8336\u5BB4\u4FBF\u5E94\u8FD0\u800C\u751F\u4E86\u3002\n\u74E6\u732B\u79CD\u7C7B\u7E41\u591A\u3001\u9020\u578B\u8FE5\u5F02\uFF0C\u6700\u5F15\u4EBA\u6CE8\u76EE\u7684\u662F\u5B83\u54A7\u7740\u5927\u5634\u3001\u5C16\u7259\u5916\u9732\u3001\u9762\u76EE\u72F0\u72DE\u7684\u795E\u6001\u3002\u5B83\u867D\u4EE5
      \u201C\u732B\u201D \u4E3A\u540D\uFF0C\u5B9E\u5219 \u201C\u5BD3\u864E\u4E8E\u732B\u201D\uFF0C\u6C11\u95F4\u53C8\u79F0\u5176\u4E3A\u9547\u810A\u864E\u3001\u5409\u7965\u864E\u3002\n\u51F6\u715E\u6837\u8C8C\uFF1A\u4E3A\u4E86\u628A
      \u201C\u9B3C\u201D \u7ED9\u5413\u8DD1\n\u53E3\u5C3E\u76F8\u901A\uFF1A\u5BD3\u610F\u8D22\u6C14\u53EA\u8FDB\u4E0D\u51FA\uFF0C\u5BC4\u6258\u62DB\u8D22\u7EB3\u798F\u7684\u7948\u613F\n\U0001F6E0\u4E61\u571F\u667A\u6167\n\u5728\u798F\u5EFA\u6CBF\u6D77\u5730\u533A\uFF0C\u7A7A\u5FC3\u7684\u74E6\u732B\u5728\u5F3A\u98CE\u8FC7\u5883\u65F6\u4F1A\u53D1\u51FA\u545C\u545C\u9E23\u54CD\uFF0C\u53EF\u4F5C\u4E3A\u9884\u5224\u53F0\u98CE\u7684\u5929\u7136\u62A5\u8B66\u5668\uFF0C\u517C\u5177\u6C14\u8C61\u9884\u8B66\u7684\u5B9E\u7528\u529F\u80FD\u3002\n\u4ECE\u5C4B\u810A\u7684\u5B88\u62A4\u795E\uFF0C\u5230\u6A90\u53E3\u7684\u6EF4\u6C34\u517D\uFF0C\u74E6\u732B\u4E0E\u5404\u7C7B\u4E61\u571F\u5EFA\u7B51\u6784\u4EF6\u76F8\u8F85\u76F8\u6210\uFF0C\u5171\u540C\u6784\u6210\u4E86\u72EC\u7279\u7684\u95FD\u5357\u5EFA\u7B51\u6587\u5316\u7B26\u53F7\u3002\u660E\u672B\u540D\u5C06\u621A\u7EE7\u5149\u6D88\u706D\u5165\u4FB5\u502D\u5BC7\u65F6\uFF0C\u6F33\u5DDE\u767E\u59D3\u8DF3\u8D77\u5927\u9F13\u51C9\u4F1E\u821E\uFF0C\u7528\u6B22\u5E86\u7684\u65B9\u5F0F\u5E86\u795D\u80DC\u5229\u3002\u8FD9\u4E00\u6BB5\u5386\u53F2\uFF0C\u8BA9\u6211\u60F3\u8D77\u4E86\u6211\u53BF\u4E00\u4E9B\u5BFA\u5E99\u66FE\u6709\u5927\u9F13\u51C9\u4F1E\u53C2\u4E0E\u5E99\u5E86\u6D3B\u52A8\u7684\u8BB0\u8F7D\u3002\u8FD9\u79CD\u5BCC\u6709\u5E86\u795D\u6C1B\u56F4\u7684\u821E\u8E48\uFF0C\u4F20\u627F\u81F3\u4ECA\uFF0C\u4ECD\u5728\u6211\u4EEC\u7684\u751F\u6D3B\u4E2D\u95EA\u8000\u7740\u5149\u8292\u3002\n\u5C71\u57CE\u6CE8\u751F\u5A18\u5BAB\u81EA\u5EFA\u5927\u9F13\u51C9\u4F1E\u961F\uFF0C\u8058\u8BF7\u8001\u5E08\u4F20\u827A\uFF0C\u6F14\u51FA\u6548\u679C\u975E\u5E38\u597D\uFF0C\u751A\u81F3\u8FD8\u5916\u8058\u5BA3\u4F20\u6F14\u51FA\u3002\u7136\u800C\uFF0C\u591A\u6570\u6F14\u5458\u9700\u8981\u7EF4\u6301\u751F\u8BA1\uFF0C\u6F14\u51FA\u9010\u6E10\u96BE\u4EE5\u4E3A\u7EE7\uFF0C\u9057\u61BE\u89E3\u6563\u3002\u8FD9\u4E00\u5207\u7684\u80CC\u540E\uFF0C\u662F\u5BF9\u6C11\u95F4\u4F20\u7EDF\u6587\u5316\u7684\u6D41\u5931\u3002\n\u6F33\u5DDE\u5927\u9F13\u51C9\u4F1E\uFF0C\u627F\u8F7D\u7740\u5386\u53F2\u7684\u5149\u8F89\u548C\u4EBA\u4EEC\u5BF9\u80DC\u5229\u7684\u5E86\u795D\u3002\u611F\u8C22\u53BF\u8001\u4F53\u534F\u7684\u52AA\u529B\uFF0C\u8FD9\u9879\u4F20\u7EDF\u821E\u8E48\u5F97\u4EE5\u4F20\u627F\u5E76\u5728\u6D3B\u6001\u4E2D\u7EE7\u7EED\u53D1\u5C55\u3002\u8BA9\u6211\u4EEC\u4E00\u8D77\u4E3A\u8FD9\u4EFD\u7480\u74A8\u7684\u6587\u5316\u9057\u4EA7\u70B9\u8D5E\uFF0C\u652F\u6301\u5927\u9F13\u51C9\u4F1E\u961F\u7684\u52AA\u529B\uFF0C\u8BA9\u5B83\u4EEC\u7684\u8868\u6F14\u7EE7\u7EED\u95EA\u8000\u5728\u4EBA\u4EEC\u7684\u751F\u6D3B\u4E2D\u3002"
