    characterSequence: "\u7948\u5E74\u6BBF\u7684\u5185\u90E8\u7ED3\u6784\u53EF\u4EE5\u8BF4\u662F\u53E4\u4EE3\u5EFA\u7B51\u7684\u4E00\u4E2A\u7CBE\u5DE7\u6770\u4F5C\u3002\r\n\u5B83\u6700\u6838\u5FC3\u7684\u662F\u56DB\u6839
