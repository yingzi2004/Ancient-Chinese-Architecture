    characterSequence: "\u5510\u4EE3\u9648\u5143\u5149\u5F00\u6F33\u65F6\u7684\u5175\u8425\u3001\u57CE\u5821\uFF0C\u4EE5\u53CA\u5317\u5B8B\u7684\u751F\u571F\u592F\u7B51\u5BE8\u5821\uFF0C\u662F\u571F\u697C\u6700\u65E9\u7684\u96CF\u5F62\uFF0C\u4EE5\u519B\u4E8B\u9632\u5FA1\u4E3A\u6838\u5FC3\u529F\u80FD\u3002\u8D77\u6E90\u4E2D\u539F\u79FB\u6C11\u805A\u65CF\u800C\u5C45\u7684\u9700\u6C42\uFF0C\u8BA9\u571F\u5821\u5BE8\u7684\u9632\u5FA1\u529F\u80FD\u4E0E\u6C11\u5C45\u7ED3\u5408\uFF0C\u51FA\u73B0\u4E86\u65B9\u5F62\u3001\u957F\u65B9\u5F62\u7684\u65E9\u671F\u571F\u697C\uFF0C\u9F99\u5B89\u5BE8\u7B49\u9057\u5740\u53EF\u8BC1\u3002\u96CF\u5F62\u671F\uFF08\u5510\u81F3\u5317\u521D\u6B65\u5F62\u6210\u671F\uFF08\u5357\u5B8B\u81F3\u5143\uFF09\u5B8B\uFF09\u5609\u9756\u5E74\u95F4\u56E0\u502D\u5BC7\u3001\u6D77\u76D7\u4FB5\u6270\uFF0C\u571F\u697C\u5F00\u59CB\u5927\u91CF\u5174\u5EFA\uFF0C\u300A\u91CD\u4FEE\u8654\u53F0\u5FD7\u300B\u9996\u6B21\u51FA\u73B0
      \u201C\u571F\u697C\u201D \u8BB0\u8F7D\uFF0C\u5F62\u5236\u4EE5\u65B9\u697C\u4E3A\u4E3B\u3002\u5FEB\u901F\u53D1\u5C55\u671F\uFF08\u660E\u4EE3\u4E2D\u665A\u671F\uFF09\u90D1\u6210\u529F\u4E0E\u6E05\u519B\u7684\u62C9\u952F\u6218\u4FC3\u4F7F\u6C11\u95F4\u5927\u89C4\u6A21\u5EFA\u697C\u81EA\u4FDD\uFF0C\u571F\u697C\u5206\u5E03\u8303\u56F4\u6269\u5927\uFF0C\u5F00\u59CB\u5411\u95FD\u897F\u5357\u6269\u6563\u3002\u8F6C\u578B\u62D3\u5C55\u671F\uFF08\u660E\u672B\u6E05\u521D\uFF09\u571F\u697C\u5F62\u5236\u591A\u5143\u5316\uFF0C\u51FA\u73B0\u5706\u697C\u3001\u5E9C\u7B2C\u5F0F\u571F\u697C\uFF0C\u529F\u80FD\u4ECE\u9632\u5FA1\u8F6C\u5411\u5C45\u4F4F\u3001\u6559\u5316\u7B49\u590D\u5408\u9700\u6C42\uFF0C\u90E8\u5206\u878D\u5165\u897F\u6D0B\u5EFA\u7B51\u5143\u7D20\u3002\u9F0E\u76DB\u6210\u719F\u671F\uFF08\u6E05\u4EE3\u81F3\u4F20\u7EDF\u571F\u697C\u9010\u6E10\u9000\u51FA\u65E5\u5E38\u5C45\u4F4F\u529F\u80FD\uFF0C\u8F6C\u800C\u6210\u4E3A\u6587\u5316\u9057\u4EA7\u4E0E\u65C5\u6E38\u8D44\u6E90\uFF0C\u5F97\u5230\u7CFB\u7EDF\u6027\u4FDD\u62A4\u4E0E\u7814\u7A76\u3002\u6C11\u56FD\uFF09\u8FD1\u73B0\u4EE3\u53D8\u8FC1\u671F\uFF0820
      \u4E16\u7EAA\u4E2D\u65B9\u5706\u4E4B\u95F4\u30FB\u798F\u5EFA\u571F\u697C\u8425\u9020\u667A\u6167\r\n\u53F6\u81F3\u4ECA\uFF09\u65B9\u578B\u571F\u697C\uFF1A\u5FAA\u5112\u5BB6\u793C\u5236\u79E9\u5E8F\uFF0C\u5C42\u7EA7\u5206\u660E\u3001\u5C0A\u5351\u6709\u5E8F\uFF0C\u683C\u5C40\u5E84\u91CD\u5982\u4E16\u5BB6\u5E9C\u90B8\uFF0C\u9002\u914D\u5B97\u65CF\u793C\u4EEA\u805A\u5C45\u3002\r\n\u5706\u5F62\u571F\u697C\uFF1A360\xB0
      \u65E0\u9632\u5FA1\u6B7B\u89D2\uFF0C\u53D7\u529B\u5747\u5300\u6297\u9707\u6781\u5F3A\uFF0C\u7A7A\u95F4\u5747\u5206\u5E73\u7B49\u548C\u7766\uFF0C\u662F\u62B5\u5FA1\u5C71\u532A\u3001\u9002\u914D\u5C71\u533A\u73AF\u5883\u7684\u5EFA\u7B51\u8FDB\u5316\u5178\u8303\u3002\r\n\u4E00\u65B9\u4E00\u5706\uFF0C\u65E2\u662F\u5EFA\u7B51\u5916\u5F62\u5DEE\u5F02\uFF0C\u66F4\u662F\u5BA2\u5BB6\u8FC1\u5F99\u5386\u53F2\u3001\u4EBA\u5C45\u54F2\u5B66\u4E0E\u53E4\u4EBA\u9632\u707E\u5FA1\u9669\u7684\u5343\u5E74\u667A\u6167\u7ED3\u6676\u3002\u74E6\u732B\u795E\u517D\u804C\u5B88\uFF1A\r\n\u74E6\u732B\u662F\u6816\u606F\u5728\u798F\u5EFA\u571F\u697C\u4E0E\u95FD\u5357\u53E4\u539D\u5C4B\u9876\u4E0A\u7684\u795E\u517D\uFF0C\u4E13\u95E8\u8D1F\u8D23\u5728\u5C4B\u9876\u4E0A\u5F20\u5927\u773C\u775B\u3001\u864E\u89C6\u7708\u7708\uFF0C\u4ECE\u5C4B\u9876\u5230\u5899\u57FA\uFF0C\u90FD\u5728\u5B83\u5162\u5162\u4E1A\u4E1A\u7684\u5B88\u62A4\u8303\u56F4\u91CC\u3002\u770B\u5BB6\u62A4\u9662\u3001\u9547\u5B85\u8F9F\u90AA\uFF0C\u662F\u5B83\u4E0E\u751F\u4FF1\u6765\u7684\u8D23\u4EFB\u4E0E\u672C\u5206\u3002\r\n\u9020\u578B\u5BD3\u610F\uFF1A\u6700\u5916\u5C42\u90A3\u5708\u539A\u5B9E\u7684\u592F\u571F\u5899\uFF0C\u5C31\u662F\u571F\u697C\u7684\"\u94E0\u7532\"\u2014\u2014\u5899\u4F53\u5E95\u90E8\u539A\u8FBE1.5\u7C73\u751A\u81F3\u66F4\u5BBD\uFF0C\u5411\u4E0A\u9010\u6E10\u6536\u7A84\uFF0C\u65E2\u9632\u53F0\u98CE\u53C8\u5FA1\u5916\u654C\u3002\u5899\u4E0A\u90A3\u4E9B\u72ED\u5C0F\u7684\u7A97\u53E3\uFF0C\u6218\u65F6\u5C31\u662F\u67AA\u773C\u3002\u592F\r\n\u571F\u571F\u697C\u8425\u9020\u6280\u827A\uFF1A\u592F\u571F\u7684\u667A\u6167\u7ED3\u6676\u2460
      \u9009\u5740\u7B51\u57FA\r\n\u9009\u53D6\u80CC\u5C71\u9762\u6C34\u7684\u5E73\u5766\u5C71\u5730\uFF0C\u7F57\u76D8\u786E\u5B9A\u5750\u5411\u3002\u6DF1\u6316\u5730\u57FA\uFF0C\u7528\u5927\u5757\u9E45\u5375\u77F3\u5806\u780C\uFF0C\u589E\u5F3A\u571F\u697C\u7684\u6297\u9707\u4E0E\u9632\u6C34\u80FD\u529B\u3002\u4E09\u5C3A\u620F\u53F0\u85CF\u5929\u5730\uFF0C\u5341\u6307\u63D0\u7EBF\u821E\u4E7E\u5764\uFF0C\u8FD9\u95E8\u6D41\u6DCC\u516D\u767E\u4F59\u5E74\u7684\u827A\u672F\uFF0C\u4EE5\u6728\u5076\u4E3A\u5A92\u3001\u4E1D\u7EBF\u4E3A\u9B42\uFF0C\u827A\u4EBA\u6307\u5C16\u7FFB\u98DE\u95F4\uFF0C\u5080\u5121\u4FBF\u6709\u4E86\u7709\u773C\u98CE\u9AA8\uFF0C\u5728\u65B9\u5BF8\u4E4B\u4E0A\u6F14\u7ECE\u5343\u5E74\u60B2\u6B22\uFF0C\u627F\u8F7D\u7740\u5BA2\u5BB6\u4EBA\u6700\u6DF1\u6C89\u7684\u60C5\u6000\u3002\u697C\u524D\u9523\u9F13\u55A7
      \xB7 \u5927\u9F13\u51C9\u4F1E\r\n2021\u5E74\uFF0C\u95FD\u897F\u5BA2\u5BB6\u6728\u5076\u620F\u6B63\u5F0F\u5165\u9009\u7B2C\u4E94\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u540D\u5F55\uFF0C\u8FD9\u4EFD\u8DE8\u8D8A\u516D\u767E\u5E74\u7684\u575A\u5B88\uFF0C\u7EC8\u4E8E\u88AB\u954C\u523B\u5728\u56FD\u5BB6\u7EA7\u975E\u9057\u7684\u53F2\u518C\u4E4B\u4E0A\u3002\u8FD9\u95E8\u53E4\u8001\u827A\u672F\uFF0C\u66F4\u5728\u571F\u5730\u9769\u547D\u65F6\u671F\uFF0C\u4E66\u5199\u4E86\u4E00\u6BB5\u70ED\u8840\u6CB8\u817E\u7684\u7EA2\u8272\u4F20\u5947\u2014\u2014\u6728\u5076\u827A\u4EBA\u4E18\u5FC5\u4E66\u3001\u5F90\u4F20\u534E\u7B49\u4EBA\uFF0C\u4EE5\u620F\u4E3A\u5203\u3001\u4EE5\u827A\u4E3A\u6865\uFF0C\u7F16\u6F14\u300A\u6253\u571F\u8C6A\u300B\u300A\u6269\u5927\u7EA2\u519B\u300B\u7B49\u5267\u76EE\uFF0C\u5728\u620F\u53F0\u4E4B\u4E0A\u4F20\u9012\u9769\u547D\u706B\u79CD\uFF0C\u66F4\u501F\u6F14\u51FA\u4E4B\u4FBF\uFF0C\u5C06\u60C5\u62A5\u85CF\u4E8E\u6728\u5076\u8863\u7F1D\u3001\u5C06\u7269\u8D44\u85CF\u4E8E\u620F\u7BB1\uFF0C\u7528\u5320\u5FC3\u4E0E\u5FE0\u8BDA\uFF0C\u5B88\u62A4\u7740\u9769\u547D\u5E0C\u671B\u3002\u660E\u672B\u540D\u5C06\u621A\u7EE7\u5149\u6D88\u706D\u5165\u4FB5\u502D\u5BC7\u65F6\uFF0C\u6F33\u5DDE\u767E\u59D3\u8DF3\u8D77\u5927\u9F13\u51C9\u4F1E\u821E\uFF0C\u7528\u6B22\u5E86\u7684\u65B9\u5F0F\u5E86\u795D\u80DC\u5229\u3002\u8FD9\u4E00\u6BB5\u5386\u53F2\uFF0C\u8BA9\u6211\u60F3\u8D77\u4E86\u6211\u53BF\u4E00\u4E9B\u5BFA\u5E99\u66FE\u6709\u5927\u9F13\u51C9\u4F1E\u53C2\u4E0E\u5E99\u5E86\u6D3B\u52A8\u7684\u8BB0\u8F7D\u3002\u8FD9\u79CD\u5BCC\u6709\u5E86\u795D\u6C1B\u56F4\u7684\u821E\u8E48\uFF0C\u4F20\u627F\u81F3\u4ECA\uFF0C\u4ECD\u5728\u6211\u4EEC\u7684\u751F\u6D3B\u4E2D\u95EA\u8000\u7740\u5149\u8292\u3002\r\n\u5C71\u57CE\u6CE8\u751F\u5A18\u5BAB\u81EA\u5EFA\u5927\u9F13\u51C9\u4F1E\u961F\uFF0C\u8058\u8BF7\u8001\u5E08\u4F20\u827A\uFF0C\u6F14\u51FA\u6548\u679C\u975E\u5E38\u597D\uFF0C\u751A\u81F3\u8FD8\u5916\u8058\u5BA3\u4F20\u6F14\u51FA\u3002\u7136\u800C\uFF0C\u591A\u6570\u6F14\u5458\u9700\u8981\u7EF4\u6301\u751F\u8BA1\uFF0C\u6F14\u51FA\u9010\u6E10\u96BE\u4EE5\u4E3A\u7EE7\uFF0C\u9057\u61BE\u89E3\u6563\u3002\u8FD9\u4E00\u5207\u7684\u80CC\u540E\uFF0C\u662F\u5BF9\u6C11\u95F4\u4F20\u7EDF\u6587\u5316\u7684\u6D41\u5931\u3002\r\n\u6F33\u5DDE\u5927\u9F13\u51C9\u4F1E\uFF0C\u627F\u8F7D\u7740\u5386\u53F2\u7684\u5149\u8F89\u548C\u4EBA\u4EEC\u5BF9\u80DC\u5229\u7684\u5E86\u795D\u3002\u611F\u8C22\u53BF\u8001\u4F53\u534F\u7684\u52AA\u529B\uFF0C\u8FD9\u9879\u4F20\u7EDF\u821E\u8E48\u5F97\u4EE5\u4F20\u627F\u5E76\u5728\u6D3B\u6001\u4E2D\u7EE7\u7EED\u53D1\u5C55\u3002\u8BA9\u6211\u4EEC\u4E00\u8D77\u4E3A\u8FD9\u4EFD\u7480\u74A8\u7684\u6587\u5316\u9057\u4EA7\u70B9\u8D5E\uFF0C\u652F\u6301\u5927\u9F13\u51C9\u4F1E\u961F\u7684\u52AA\u529B\uFF0C\u8BA9\u5B83\u4EEC\u7684\u8868\u6F14\u7EE7\u7EED\u95EA\u8000\u5728\u4EBA\u4EEC\u7684\u751F\u6D3B\u4E2D\u3002\r\n\u95FD\u897F\u5BA2\u5BB6\u6728\u5076\u620F\uFF0C\u662F\u6307\u5C16\u7684\u7EDD\u827A\uFF0C\u662F\u5BA2\u5BB6\u7684\u9B42\u97F5\uFF0C\u662F\u516D\u767E\u5E74\u65F6\u5149\u6C89\u6DC0\u7684\u975E\u9057\u7470\u5B9D\u3002\u5B83\u85CF\u7740\u95FD\u897F\u4EBA\u7684\u5320\u5FC3\u4E0E\u575A\u5B88\uFF0C\u85CF\u7740\u5BA2\u5BB6\u4EBA\u7684\u5BB6\u56FD\u4E0E\u60B2\u6B22\uFF0C\u85CF\u7740\u975E\u9057\u6587\u5316\u7684\u751F\u751F\u4E0D\u606F\u3002\r\n\u2461
      \u5236\u576F\u592F\u571F\r\n\u9ECF\u571F\u4E0E\u7802\u77F3\u6309\u6BD4\u4F8B\u6DF7\u5408\uFF0C\u52A0\u5165\u7EA2\u7CD6\u3001\u7CEF\u7C73\u6D46\u589E\u52A0\u9ECF\u6027\u3002\u5012\u5165\u6728\u6A21\uFF0C\u7528\u6728\u592F\u9010\u5C42\u592F\u5B9E\u2014\u2014\u8FD9\u5C31\u662F\u60A8\u5373\u5C06\u4F53\u9A8C\u7684\u201C\u5343\u94F2\u4E07\u6775\u201D\uFF0C\u6BCF\u5C42\u539A\u5EA6\u5747\u5300\uFF0C\u786E\u4FDD\u571F\u5899\u575A\u56FA\u8010\u7528\u3002\u697C\u5185\u8336\u70DF\u8D77
      \xB7 \u5BA2\u5BB6\u64C2\u8336\u64C2\u8336\u662F\u5BA2\u5BB6\u4EBA\u4ECE\u4E2D\u539F\u5411\u5357\u65B9\u8FC1\u5F99\u4E2D\u7559\u4E0B\u7684\u5B9D\u8D35\u8D22\u5BCC\uFF0C\u662F\u5BA2\u5BB6\u4EBA\u6700\u666E\u901A\u4E5F\u662F\u6700\u9686\u91CD\u7684\u4E00\u79CD\u5F85\u5BA2\u793C\u4EEA\uFF0C\u5BA2\u5BB6\u64C2\u8336\u662F\u4FDD\u7559\u4E0B\u6765\u7684\u4E2D\u56FD\u6700\u53E4\u8001\u7684\u8336\u9053\u4E4B\u4E00\uFF0C\u88AB\u8A89\u4E3A\u201C\u4E2D\u56FD\u8336\u6587\u5316\u7684\u6D3B\u5316\u77F3\u201D\u3002\u697C\u4E2D\u620F\u53F0\u6696
      \xB7 \u5BA2\u5BB6\u6728\u5076\r\n\u5BA2\u5BB6\u64C2\u8336\u662F\u4F20\u7EDF\u7684\u98DF\u4FD7\u3002\u5BA2\u5BB6\u4EBA\u70ED\u60C5\u597D\u5BA2\uFF0C\u4EE5\u64C2\u8336\u5F85\u5BA2\u66F4\u662F\u4F20\u7EDF\u7684\u666E\u904D\u7684\u793C\u8282\u3002\u64C2\u8336\u6709\u4E00\u5957\u79F0\u4E3A\u201C\u64C2\u8336\u4E09\u5B9D\u201D\u7684\u5DE5\u5177\uFF1A\u4E00\u662F\u53E3\u5F8450\u5398\u7C73\u4E14\u5185\u58C1\u6709\u7C97\u5BC6\u6C9F\u7EB9\u7684\u9676\u5236\u64C2\u94B5\uFF1B\u4E8C\u662F\u7528\u4E0A\u7B49\u5C71\u6942\u6728\u6216\u6CB9\u8336\u6811\u5E72\u52A0\u5DE5\u5236\u6210\u7684\u7EA685\u5398\u7C73\u957F\u7684\u64C2\u68CD\uFF1B\u4E09\u662F\u7528\u7AF9\u7BFE\u5236\u6210\u7684\u635E\u6EE4\u788E\u6E23\u7684\u201C\u635E\u5B50\u201D\u3002\r\n\u5236\u4F5C\u65F6\uFF0C\u5148\u5C06\u6240\u914D\u7F6E\u597D\u7684\u6750\u6599\uFF0C\u6309\u6BD4\u4F8B\u653E\u7F6E\u64C2\u94B5\u5185\uFF0C\u7528\u64C2\u6775\u6CBF\u94B5\u5185\u58C1\u9006\u6C9F\u7EB9\u8D70\u5411\u9891\u9891\u8202\u6363\u3001\u65CB\u8F6C\u78E8\u6210\u8336\u6CE5\u3002\u5BA2\u5BB6\u64C2\u8336\u65E2\u6709\u8336\u53F6\u7684\u7518\u5473\uFF0C\u829D\u9EBB\u3001\u82B1\u751F\u3001\u8C46\u5B50\u7684\u6E05\u9999\uFF0C\u4E5F\u6709\u751F\u59DC\u7684\u8FA3\u5473\uFF0C\u82E5\u518D\u4F50\u4EE5\u7092\u7C73\u3001\u82B1\u751F\u7C73\u3001\u8C46\u74E3\u3001\u7C73\u679C\u3001\u70EB\u76AE\u7B49\uFF0C\u4E00\u684C\u96C6\u9999\u3001\u751C\u3001\u8106\u3001\u8FA3\u4E8E\u4E00\u4F53\u7684\u5BA2\u5BB6\u64C2\u8336\u5BB4\u4FBF\u5E94\u8FD0\u800C\u751F\u4E86\u3002\r\n\r\n\u2462
      \u780C\u5899\u5F00\u7A97\r\n\u6309\u5706\u5F62\u6216\u65B9\u5F62\u5F62\u5236\u780C\u7B51\u592F\u571F\u5899\uFF0C\u5899\u4F53\u5206\u5C42\u6536\u5206\u4F7F\u5176\u7A33\u56FA\u3002\u5F00\u51FF\u9519\u843D\u7684\u77AD\u671B\u7A97\u4E0E\u5C04\u51FB\u5B54\uFF0C\u517C\u987E\u9632\u5FA1\u4E0E\u91C7\u5149\u9700\u6C42\u3002\r\n\u2463
      \u67B6\u6881\u76D6\u9876\r\n\u9009\u53D6\u7C97\u58EE\u6749\u6728\u4F5C\u4E3B\u6881\uFF0C\u69AB\u536F\u7ED3\u6784\u56FA\u5B9A\u5728\u571F\u5899\u9876\u7AEF\u3002\u94FA\u8BBE\u693D\u5B50\u3001\u74E6\u7247\uFF0C\u5761\u5F62\u5C4B\u9876\u4FBF\u4E8E\u5FEB\u901F\u6392\u6C34\uFF0C\u4FDD\u62A4\u571F\u5899\u4E0D\u53D7\u96E8\u6C34\u4FB5\u8680\u3002\r\n\u2464
      \u88C5\u4FEE\u843D\u6210\r\n\u4FEE\u6574\u5185\u90E8\u623F\u95F4\u9694\u65AD\u3001\u6728\u8D28\u95E8\u7A97\uFF0C\u94FA\u8BBE\u77F3\u677F\u5730\u9762\u3002\u5B8C\u5DE5\u540E\u4E3E\u529E\u843D\u6210\u5E86\u5178\uFF0C\u96C6\u5C45\u4F4F\u3001\u9632\u5FA1\u529F\u80FD\u4E8E\u4E00\u4F53\uFF0C\u6210\u5C31\u5BA2\u5BB6\u6C11\u5C45\u72EC\u7279\u7470\u5B9D\u3002\r\n\u7B51\r\n\u7684\r\n\u65CF\r\n\u8C31\r\n\u5F80\u91CC\u770B\uFF0C\u4E00\u5708\u5708\u540C\u5FC3\u5706\u822C\u7684\u6728\u6784\u5EFA\u7B51\uFF0C\u662F\u65CF\u4EBA\u7684\u5C45\u4F4F\u7A7A\u95F4\u3002\u901A\u5E38\u4E00\u697C\u53A8\u623F\u3001\u4E8C\u697C\u7CAE\u4ED3\u3001\u4E09\u56DB\u697C\u4F4F\u4EBA\uFF0C\u5782\u76F4\u4E00\u6237\uFF0C\u65B9\u4FBF\u53C8\u79C1\u5BC6\u3002\r\n\u4E2D\u5FC3\u90A3\u65B9\u5C0F\u9662\u843D\uFF0C\u662F\u6574\u5EA7\u697C\u7684\"\u5FC3\u810F\"\u3002\u7956\u5802\u8BBE\u5728\u8FD9\u91CC\uFF0C\u4F9B\u5949\u7956\u5148\u724C\u4F4D\uFF0C\u4E5F\u662F\u5A5A\u4E27\u5AC1\u5A36\u3001\u8BAE\u4E8B\u805A\u4F1A\u7684\u516C\u5171\u573A\u6240\u3002\u6C34\u4E95\u5F80\u5F80\u4E5F\u5728\u9662\u5185\uFF0C\u5168\u697C\u4EBA\u5171\u4EAB\u8FD9\u4E00\u773C\u6D3B\u6CC9\u3002\r\n\u8FD9\u79CD\"\u5411\u5FC3\u800C\u5C45\"\u7684\u683C\u5C40\uFF0C\u628A\u51E0\u5341\u6237\u540C\u65CF\u4EBA\u5BB6\u7D27\u7D27\u6346\u5728\u4E00\u8D77\u2014\u2014\u5BF9\u5916\u662F\u4E00\u4E2A\u575A\u56FA\u5821\u5792\uFF0C\u5BF9\u5185\u662F\u4E00\u4E2A\u81EA\u7ED9\u81EA\u8DB3\u7684\u5C0F\u793E\u4F1A\u3002\r\n\u74E6\u732B\u79CD\u7C7B\u7E41\u591A\u3001\u9020\u578B\u8FE5\u5F02\uFF0C\u6700\u5F15\u4EBA\u6CE8\u76EE\u7684\u662F\u5B83\u54A7\u7740\u5927\u5634\u3001\u5C16\u7259\u5916\u9732\u3001\u9762\u76EE\u72F0\u72DE\u7684\u795E\u6001\u3002\u5B83\u867D\u4EE5
      \u201C\u732B\u201D \u4E3A\u540D\uFF0C\u5B9E\u5219 \u201C\u5BD3\u864E\u4E8E\u732B\u201D\uFF0C\u6C11\u95F4\u53C8\u79F0\u5176\u4E3A\u9547\u810A\u864E\u3001\u5409\u7965\u864E\u3002\u4E00\u5EA7\u697C\uFF0C\u4E00\u4E2A\u65CF\uFF0C\u51E0\u4EE3\u4EBA\r\n 
      \u51F6\u715E\u6837\u8C8C\uFF1A\u4E3A\u4E86\u628A \u201C\u9B3C\u201D \u7ED9\u5413\u8DD1\u571F\u697C\u6B63\u95E8\u4E0A\u4F1A\u8D34\u5BF9\u8054\u5BF9\u8054\u4F1A\u6839\u636E\u5B63\u8282\u6709\u6240\u6539\u53D8\uFF0C\u6BCF\u9022\u65B0\u5E74\u4F73\u8282\u571F\u697C\u7684\u5C4B\u6A90\u4E0B\u4E5F\u4F1A\u6302\u6EE1\u706F\u7B3C\uFF0C\u4E0E\u5BF9\u8054\u547C\u5E94\r\n 
      \u53E3\u5C3E\u76F8\u901A\uFF1A\u5BD3\u610F\u8D22\u6C14\u53EA\u8FDB\u4E0D\u51FA\uFF0C\u5BC4\u6258\u62DB\u8D22\u7EB3\u798F\u7684\u7948\u613F\r\n\u4E61\u571F\u667A\u6167\uFF1A\r\n\u5728\u798F\u5EFA\u6CBF\u6D77\u5730\u533A\uFF0C\u7A7A\u5FC3\u7684\u74E6\u732B\u5728\u5F3A\u98CE\u8FC7\u5883\u65F6\u4F1A\u53D1\u51FA\u545C\u545C\u9E23\u54CD\uFF0C\u53EF\u4F5C\u4E3A\u9884\u5224\u53F0\u98CE\u7684\u5929\u7136\u62A5\u8B66\u5668\uFF0C\u517C\u5177\u6C14\u8C61\u9884\u8B66\u7684\u5B9E\u7528\u529F\u80FD\u3002\r\n\u4ECE\u5C4B\u810A\u7684\u5B88\u62A4\u795E\uFF0C\u5230\u6A90\u53E3\u7684\u6EF4\u6C34\u517D\uFF0C\u74E6\u732B\u4E0E\u5404\u7C7B\u4E61\u571F\u5EFA\u7B51\u6784\u4EF6\u76F8\u8F85\u76F8\u6210\uFF0C\u5171\u540C\u6784\u6210\u4E86\u72EC\u7279\u7684\u95FD\u5357\u5EFA\u7B51\u6587\u5316\u7B26\u53F7\u3002\r\n\u571F\u697C\u5C4B\u810A\u4E0A\u7684\u5B88\u62A4\u795E"
