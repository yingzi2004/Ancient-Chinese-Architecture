    characterSetSelectionMode: 7
    characterSequence: "\u5C71\u897F\u5730\u7406\u5C01\u95ED\uFF0C\u81EA\u53E4\u805A\u65CF\u800C\u5C45\uFF0C\u5F62\u6210\u6CE8\u91CD\u9632\u5FA1\u7684\u4F20\u7EDF\u3002\u65E9\u671F\u7A91\u6D1E\u4E0E\u7B80\u6613\u5408\u9662\u5960\u5B9A\u4E86\u57FA\u672C\u7A7A\u95F4\u6A21\u5F0F\u3002\u5143\u4EE3\u53CA\u4EE5\u524D\u7684\u9662\u843D\u9057\u5B58\uFF0C\u683C\u5C40\u6734\u7D20\uFF0C\u89C4\u6A21\u8F83\u5C0F\u6E90\u8D77\u4E0E\u96CF\u5F62\u671F\u664B\u5546\u7ECF\u8425\u6269\u5C55\u81F3\u8336\u53F6\u3001\u65B9\u578B\u571F\u697C\uFF1A\u5FAA\u5112\u5BB6\u793C\u5236\u79E9\u5E8F\uFF0C\u5C42\u7EA7\u5206\u660E\u3001\u5C0A\u5351\u6709\u5E8F\uFF0C\u683C\u5C40\u5E84\u91CD\u5982\u4E16\u5BB6\u5E9C\u90B8\uFF0C\u9002\u914D\u5B97\u65CF\u793C\u4EEA\u805A\u5C45\u3002\n\u5706\u5F62\u571F\u697C\uFF1A360\xB0
      \u65E0\u9632\u5FA1\u6B7B\u89D2\uFF0C\u53D7\u529B\u5747\u5300\u6297\u9707\u6781\u5F3A\uFF0C\u7A7A\u95F4\u5747\u5206\u5E73\u7B49\u548C\u7766\uFF0C\u662F\u62B5\u5FA1\u5C71\u532A\u3001\u9002\u914D\u5C71\u533A\u73AF\u5883\u7684\u5EFA\u7B51\u8FDB\u5316\u5178\u8303\u3002\n\u4E00\u65B9\u4E00\u5706\uFF0C\u65E2\u662F\u5EFA\u7B51\u5916\u5F62\u5DEE\u5F02\uFF0C\u66F4\u662F\u5BA2\u5BB6\u8FC1\u5F99\u5386\u53F2\u3001\u4EBA\u5C45\u54F2\u5B66\u4E0E\u53E4\u4EBA\u9632\u707E\u5FA1\u9669\u7684\u5343\u5E74\u667A\u6167\u7ED3\u6676\u3002\u91D1\u878D\u7B49\u9886\u57DF\uFF0C\u8D22\u5BCC\u6025\u5267\u79EF\u7D2F\u3002\u5927\u9662\u98CE\u683C\u6210\u719F\uFF0C\u5F62\u6210\u5B8F\u5927\u7684\u57CE\u5821\u5F0F\u5EFA\u7B51\u7FA4\uFF0C\u4E25\u683C\u9075\u5FAA\u793C\u5236\uFF0C\u4E09\u96D5\u6280\u827A\u767B\u5CF0\u9020\u6781\uFF0C\u529F\u80FD\u5206\u533A\u660E\u786E\u3002\u4E54\u5BB6\u3001\u6E20\u5BB6\u3001\u738B\u5BB6\u65B9\u5706\u4E4B\u95F4\u30FB\u798F\u5EFA\u571F\u697C\u8425\u9020\u667A\u6167\u3001\u5E38\u5BB6\u7B49\u5927\u9662\u96C6\u7FA4\u4E3A\u5176\u4EE3\u8868\u3002\u6210\u719F\u9F0E\u76DB\u671F-\u6E05\u5EB7\u7199\u81F3\u5149\u7EEA\u4E2D\u671F\u793E\u4F1A\u53D8\u9769\u540E\uFF0C\u5927\u9662\u6536\u5F52\u56FD\u6709\uFF0C\u591A\u6539\u4E3A\u516C\u7528\u6216\u6210\u4E3A\u6742\u9662\uFF0C\u5E74\u4E45\u5931\u4FEE\u906D\u7834\u574F\u3002\u5176\u5C45\u4F4F\u529F\u80FD\u7EC8\u7ED3\uFF0C\u4F46\u5386\u53F2\u4E0E\u827A\u672F\u4EF7\u503C\u5F00\u59CB\u83B7\u5F97\u5B66\u754C\u8BA4\u77E5\u3002\u6C89\u5BC2\u9057\u4EA7\u671F-20\u4E16\u7EAA\u4E2D\u53F6\u81F3\u672B\u53F6\u660E\u671D\u201C\u5F00\u4E2D\u6CD5\u201D\u4FC3\u4F7F\u664B\u5546\u4EE5\u76D0\u4E1A\u5174\u8D77\uFF0C\u660E\u521D\u79FB\u6C11\u4E5F\u63A8\u52A8\u4E86\u6587\u5316\u4EA4\u878D\u3002\u5EFA\u7B51\u4E0A\u51FA\u73B0\u660E\u786E\u8F74\u7EBF\u4E0E\u56DB\u5408\u9662\u5E03\u5C40\uFF0C\u7816\u6728\u666E\u53CA\uFF0C\u8BB2\u7A76\u98CE\u6C34\u3002\u5BCC\u6237\u59CB\u5EFA\u697C\u9662\uFF0C\u5821\u5BE8\u96CF\u5F62\u663E\u73B0\uFF0C\u5982\u738B\u5BB6\u5927\u9662\u65E9\u671F\u683C\u5C40\u4FBF\u4E8E\u6B64\u671F\u5960\u5B9A\u3002\u521D\u521B\u878D\u5408\u671F-\u660E\u6D2A\u6B66\u81F3\u4E07\u5386\u5E74\u95F4\u9E26\u7247\u6218\u4E89\u540E\uFF0C\u664B\u5546\u63A5\u89E6\u897F\u5B66\u4F46\u968F\u540E\u8870\u843D\u3002\u5EFA\u7B51\u5728\u4F20\u7EDF\u4E2D\u878D\u5165\u62F1\u5238\u7A97\u3001\u5DF4\u6D1B\u514B\u67F1\u5934\u7B49\u897F\u6D0B\u5143\u7D20\uFF0C\u5F62\u6210\u4E2D\u897F\u5408\u74A7\u98CE\u8C8C\uFF0C\u53CD\u6620\u4E86\u65F6\u4EE3\u5BA1\u7F8E\u53D8\u8FC1\uFF0C\u4EE5\u5B54\u7965\u7199\u5B85\u9662\u7B49\u4E3A\u4EE3\u8868\u3002\u53D8\u5F02\u4E0E\u897F\u5316\u671F-\u660E\u672B\u6E05\u521D\u7535\u5F71\u300A\u5927\u7EA2\u706F\u7B3C\u9AD8\u9AD8\u6302\u300B\u5F15\u53D1\u5173\u6CE8\uFF0C\u5E26\u52A8\u201C\u664B\u5546\u6587\u5316\u70ED\u201D\u3002\u5404\u5927\u9662\u5217\u4E3A\u56FD\u4FDD\u5355\u4F4D\uFF0C\u7ECF\u4FEE\u7F2E\u540E\u4F5C\u4E3A\u535A\u7269\u9986\u3001\u666F\u533A\u5F00\u653E\uFF0C\u6210\u4E3A\u7814\u7A76\u660E\u6E05\u793E\u4F1A\u4E0E\u5EFA\u7B51\u7684\u6D3B\u6001\u6807\u672C\uFF0C\u5E76\u5217\u5165\u4E16\u9057\u9884\u5907\u540D\u5355\u3002\u4FDD\u62A4\u4E0E\u590D\u5174\u671F-20\u4E16\u7EAA90\u5E74\u4EE3\u81F3\u4ECA\u738B\u5BB6\u5927\u9662\u5E38\u5BB6\u5E84\u56ED\u6881\u5BB6\u5927\u9662\u66F9\u5BB6\u5927\u9662  
      \u664B\u5546\u5927\u9662\u662F\u660E\u6E05\u65F6\u671F\u5BCC\u53EF\u654C\u56FD\u7684\u664B\u5546\u4EEC\u8863\u9526\u8FD8\u4E61\u540E\u4FEE\u5EFA\u7684\u5B85\u90B8\uFF0C\u5B83\u4EEC\u4E0D\u4EC5\u662F\u5B8F\u4F1F\u7684\u5EFA\u7B51\u7FA4\uFF0C\u66F4\u662F\u664B\u5546\u201C\u7EB5\u6A2A\u6B27\u4E9A\u4E5D\u5343\u91CC\uFF0C\u79F0\u96C4\u5546\u754C\u4E94\u767E\u5E74\u201D\u4F20\u5947\u5386\u53F2\u7684\u89C1\u8BC1\u3002 
      \r\n    \u664B\u5546\u5927\u9662\u6700\u503C\u5F97\u770B\u7684\u6709\u4E94\u5EA7\uFF1A\u4E54\u5BB6\u3001\u738B\u5BB6\u3001\u66F9\u5BB6\u3001\u674E\u5BB6\u3001\u664B\u5546\u5927\u9662\u4ECB\u7ECD\u4E54\u5BB6\u5927\u9662\u7B80\u4ECB\u4E54\u5BB6\u5927\u9662\u59CB\u5EFA\u4E8E\u6E05\u4E7E\u9686\u4E8C\u5341\u5E74\uFF081755\u5E74\uFF0C\u7531\u5728\u4E2D\u5802\u3001\u5FB7\u5174\u5802\u3001\u4FDD\u5143\u5802\u3001\u5B81\u5B88\u5802\u548C\u4E54\u5BB6\u82B1\u56ED\u4E94\u90E8\u5206\u7EC4\u6210\uFF0C\u603B\u5360\u5730\u9762\u79EF26668.9\u5E73\u65B9\u7C73\uFF0C\u5171\u670918\u4E2A\u5927\u9662\uFF0C41\u4E2A\u5C0F\u9662\uFF0C731\u95F4\u623F\u5C4B\uFF0C\u88AB\u4E2D\u56FD\u4E1C\u65B9\u6587\u5316\u7814\u7A76\u4F1A\u7B49\u5355\u4F4D\u786E\u5B9A\u4E3A\u201C\u5168\u56FD\u4EBA\u6587\u751F\u6001\u65C5\u6E38\u57FA\u5730\u201D\u88AB\u8A89\u4E3A\u201C\u5317\u65B9\u6C11\u5C45\u5EFA\u7B51\u7684\u4E00\u9897\u7480\u74A8\u7684\u660E\u73E0\u201D\uFF0C\u7D20\u6709\u201C\u7687\u5BB6\u6709\u6545\u5BAB\uFF0C\u6C11\u5B85\u770B\u4E54\u5BB6\u201D\u4E4B\u8BF4\uFF0C\u540D\u626C\u4E09\u664B\uFF0C\u8A89\u6EE1\u6D77\u5185\u5916\u3002\u5728\u4E2D\u5802\u5FB7\u5174\u5802\u5C06\u5112\u5BB6\u201C\u4E0D\u504F\u4E0D\u501A\uFF0C\u6267\u4E24\u7528\u4E2D\u201D\u7684\u201C\u4E2D\u5EB8\u201D\u4E4B\u8BF4\u5D4C\u5165\u5176\u4E2D\u3002\u201C\u5728\u4E2D\u201D\u5373\u575A\u5B88\u4E2D\u5EB8\u3002\u4E54\u81F4\u5EB8\u5BF9\u4ED6\u5B85\u7B2C\u6B63\u5802\u7684\u547D\u540D\u53EF\u89C1\u5176\u7528\u5FC3\u826F\u82E6\u3001\u7528\u610F\u7CBE\u6DF1\u3002\u5728\u4E2D\u5802\u9662\u843D\u6574\u4F53\u5E03\u5C40\u6784\u6210\u4E00\u4E2A\u5927\u5409\u5927\u5229\u7684\u201C\u56CD\u201D\u5B57\u5F62\u3002\u662F\u4E54\u5168\u5FB7\u7684\u513F\u5B50\u4E54\u81F4\u7965\u7684\u5B85\u9662\uFF0C\u5802\u540D\u53D6\u300A\u8BD7\u7ECF\u300B\u7684\u201C\u957F\u53D1\u5176\u7965\u201D\u4E0E\u300A\u4E2D\u5EB8\u300B\u7684\u201C\u60DF\u6709\u5FB7\u8005\u5C45\u4E4B\u201D\u4E4B\u610F\u3002\u9662\u843D\u7FA4\u5E03\u5217\u6709\u81F4\uFF0C\u5C42\u6B21\u5206\u660E\uFF0C\u603B\u4F53\u5E03\u5C40\u4E3A\u96B6\u4E66\u201C\u5BFF\u201D\u5B57\uFF0C\u88C5\u9970\u8003\u7A76\uFF0C\u53E4\u6734\u5178\u96C5\u3002\u4FDD\u5143\u5802\u53D6\u610F\u201C\u79C9\u627F\u79D1\u4E3E\uFF0C\u4FDD\u5143\u767B\u79D1\u201D\u3002\u4FDD\u5143\u5802\u662F\u4E54\u5BB6\u7B2C\u56DB\u4EE3\u4E54\u8D85\u4E94\u6240\u5EFA\uFF0C\u662F\u4E54\u6C0F\u5BB6\u65CF\u6700\u6709\u6587\u5316\u7684\u4E00\u652F\uFF0C\u4E0D\u4EC5\u8BBE\u8BA1\u7CBE\u5DE7\uFF0C\u5A01\u6B66\u6C14\u6D3E\uFF0C\u8FD8\u4F53\u73B0\u4E86\u5B98\u8854\u54C1\u7EA7\u7279\u8272\u3002\u5B81\u5B88\u5802\u4E3A\u4E54\u6C0F\u5BB6\u65CF\u59CB\u7956\u4E54\u8D35\u53D1\u7684\u6545\u5C45\uFF0C\u4FD7\u79F0\u201C\u8001\u9662\u201D\u3002\u5802\u540D\u53D6\u610F\u201C\u5B81\u9759\u81F4\u8FDC\uFF0C\u53D6\u4FE1\u5B88\u7EA6\u201D\u4E3A\u4E54\u6C0F\u5BB6\u65CF\u59CB\u7956\u4E54\u8D35\u53D1\u7684\u6545\u5C45\uFF0C\u4FD7\u79F0\u201C\u8001\u9662\u201D\u3002\u5802\u540D\u53D6\u610F\u201C\u5B81\u9759\u81F4\u8FDC\uFF0C\u53D6\u4FE1\u5B88\u7EA6\u201D\u4E54\u5BB6\u4E09\u96D5\u4E54\u5BB6\u5927\u9662\u7816\u96D5\u4E3B\u8981\u6709\u5806\u5851\u6CD5\u4E0E\u96D5\u5851\u6CD5\u4E24\u79CD\uFF1A\u5806\u5851\u6CD5\u4EE5\u9ECF\u571F\u576F\u624B\u96D5\u6216\u6A21\u5236\u6210\u5F62\u540E\u70E7\u5236\uFF0C\u53EF\u72EC\u7ACB\u6210\u4EF6\uFF0C\u4E5F\u80FD\u7531\u6570\u5341\u5757\u62FC\u63A5\u6210\u7167\u58C1\u7B49\u5927\u578B\u56FE\u6848\uFF1B\u96D5\u5851\u6CD5\u5219\u5728\u9752\u7816\u4E0A\u76F4\u63A5\u96D5\u523B\u6253\u78E8\u3002\u5176\u96D5\u523B\u624B\u6CD5\u4E30\u5BCC\uFF0C\u8FD0\u7528\u6D6E\u96D5\u3001\u5706\u96D5\u3001\u900F\u96D5\u3001\u5E73\u96D5\u7B49\uFF0C\u6D6E\u96D5\u5206\u9AD8\u4F4E\u6D6E\u96D5\uFF0C\u5706\u96D5\u7ACB\u4F53\u72EC\u7ACB\uFF0C\u900F\u96D5\u9542\u7A7A\u80CC\u666F\uFF0C\u5E73\u96D5\u51F9\u51F8\u9762\u5E73\u6574\uFF0C\u4E8C\u8005\u7528\u9014\u4E0D\u540C\u3001\u98CE\u683C\u5404\u5F02\u3002\u7816\u96D5\u6728\u96D5   
      \u4E54\u5BB6\u5927\u9662\u4E2D\u7684\u6728\u96D5\u88C5\u9970\u54C1\u5316\u4FD7\u4E3A\u96C5\uFF0C\u5E84\u91CD\u800C\u5178\u96C5\uFF0C\u5177\u6709\u5F3A\u70C8\u7684\u751F\u6D3B\u8DA3\u5473\u3002\u5927\u9662\u4E2D\u7684\u8FD9\u4E9B\u6728\u96D5\u827A\u672F\u54C1\u4E3B\u8981\u9760\u9524\u3001\u51FF\u7B49\u5DE5\u5177\uFF0C\u5728\u6253\u597D\u5E95\u7A3F\u7684\u6728\u8D28\u6750\u6599\u4E0A\uFF0C\u8FD0\u7528\u9AD8\u6D6E\u96D5\u3001\u6D45\u6D6E\u96D5\u3001\u9542\u7A7A\u96D5\u3001\u5706\u96D5\u7B49\u5404\u79CD\u6280\u6CD5\uFF0C\u5DE7\u5999\u5730\u96D5\u523B\u51FA\u5404\u79CD\u7F8E\u4E3D\u590D\u6742\u7684\u56FE\u6848\u3002\u4E54\u5BB6\u5927\u9662\u7684\u6728\u96D5\u88C5\u9970\u5DE5\u827A\u904D\u5E03\u5404\u4E2A\u9662\u843D\uFF0C\u4E3B\u8981\u96C6\u4E2D\u4E8E\u95E8\u697C\u3001\u5916\u6A90\u3001\u95E8\u7A97\u3001\u9694\u6247\u7B49\u5EFA\u7B51\u90E8\u4F4D\u3002\u77F3\u96D5   
      \u4E54\u5BB6\u5927\u9662\u4E2D\u7684\u77F3\u96D5\u5DE5\u827A\u54C1\u591A\u89C1\u4E8E\u95E8\u697C\u7684\u6784\u4EF6\u6216\u88C5\u9970\u7269\u4E0A\uFF0C\u5982\u77F3\u67F1\u7840\u3001\u77F3\u95E8\u58A9\u3001\u77F3\u72EE\u5B50\u3001\u77F3\u680F\u6746\u7B49\uFF0C\u56FE\u6848\u9898\u6750\u4EE5\u795E\u8BDD\u4EBA\u7269\u3001\u620F\u66F2\u6545\u4E8B\u4E3A\u4E3B\uFF0C\u4E5F\u6709\u4E0D\u5C11\u56DB\u5B63\u82B1\u5349\u3001\u7965\u79BD\u745E\u517D\u7EC4\u5408\u800C\u6210\u7684\u56FE\u6848\u3002\u77F3\u6750\u591A\u4EE5\u5E73\u6574\u7EC6\u817B\u7684\u9752\u77F3\u4E3A\u4E3B\uFF0C\u4E5F\u6709\u5C11\u6570\u6C99\u77F3\u77F3\u96D5\uFF0C\u8D28\u6734\u800C\u7C97\u72B7\u3002\u96D5\u523B\u624B\u6CD5\u4E3B\u8981\u6709\uFF1A\u5E73\u96D5\u7EBF\u523B\u3001\u9634\u7EB9\u7EBF\u523B\u3001\u5706\u96D5\u7B49\u8FDB\u884C\u523B\u753B\uFF0C\u77F3\u96D5\u753B\u9762\u6E05\u6670\u53EF\u8FA8\uFF0C\u5F62\u8C61\u903C\u771F\uFF0C\u7EBF\u6761\u7EC6\u5BC6\u6D41\u7545\u3002\u82B1\u68A8\u6728\u4E5D\u9F99\u5C4F\u98CE\r\n    
      \u8FD9\u4E2A\u5C4F\u98CE\u9AD8\u4E8C\u7C73\u4E03\uFF0C\u957F\u56DB\u7C73\u96F6\u4E03\uFF0C\u5B83\u662F\u7528\u7EAF\u82B1\u68A8\u6728\u96D5\u6210\uFF0C\u4E2D\u95F4\u7684\u4E5D\u6761\u9F99\u5B8C\u5168\u662F\u7528\u5CAB\u7389\u9576\u5D4C\uFF0C\u9887\u6709\u98DE\u9F99\u5728\u5929\uFF0C\u6829\u6829\u5982\u751F\u7684\u97F5\u5473\u3002\u9664\u4E86\u6B63\u9762\u6211\u4EEC\u770B\u5230\u7684\u4E5D\u6761\u9F99\u5916\uFF0C\u6574\u5EA7\u5C4F\u98CE\u524D\u540E\u4E0A\u4E0B\u8FD8\u5206\u522B\u96D5\u6709\u4E03\u5341\u4E8C\u6761\u5C0F\u9F99\uFF0C\u5F62\u6001\u5404\u5F02\uFF0C\u82E5\u9690\u82E5\u73B0\uFF0C\u4EA4\u9519\u76D8\u7ED5\uFF0C\u53C2\u5DEE\u6709\u81F4\u3002\u6574\u4E2A\u5C4F\u98CE\u505A\u5DE5\u7CBE\u5DE7\uFF0C\u8FD9\u662F\u4E54\u5BB6\u5927\u9662\u91CC\u4E00\u4EF6\u4EF7\u503C\u8FDE\u57CE\u7684\u9547\u5B85\u4E4B\u5B9D\u3002\u636E\u8BF4\u8FD9\u5EA7\u5C4F\u98CE\u662F\u7687\u5BAB\u7684\u4E1C\u897F\uFF0C\u662F\u516B\u56FD\u8054\u519B\u4FB5\u5360\u5317\u4EAC\u7684\u65F6\u5019\uFF0C\u4ECE\u7687\u5BAB\u6D41\u843D\u5230\u4E86\u6C11\u95F4\u3002\u4E54\u5BB6\u5927\u9662\u4E09\u5B9D\u4E5D\u9F99\u706F   
      \u4E5D\u9F99\u706F\u88AB\u8A89\u4E3A \u201C\u4E1C\u65B9\u5947\u89C2\u201D\uFF0C\u662F\u6781\u4E3A\u7A00\u6709\u7684\u4F20\u4E16\u73CD\u5B9D\uFF0C\u76EE\u524D\u4EC5\u4E54\u5BB6\u4FDD\u5B58\u4E24\u76CF\uFF0C\u636E\u4E13\u5BB6\u8003\u8BC1\uFF0C\u56FD\u5185\u5C1A\u672A\u53D1\u73B0\u7B2C\u4E09\u76CF\uFF0C\u582A\u79F0\u72EC\u4E00\u65E0\u4E8C\u3002\u6B64\u706F\u4EE5\u73CD\u8D35\u4E4C\u6728\u7CBE\u96D5\u800C\u6210\uFF0C\u901A\u9AD8\u4E5D\u5341\u4E00\u516C\u5206\uFF0C\u867D\u4F53\u91CF\u4E0D\u5927\uFF0C\u5374\u91CD\u8FBE\u4E03\u5341\u4E00\u65A4\uFF0C\u7528\u6599\u539A\u91CD\u3001\u5DE5\u827A\u8003\u7A76   
      \u706F\u8EAB\u96D5\u523B\u4E5D\u6761\u9F99\uFF0C\u6545\u800C\u5F97\u540D \u201C\u4E5D\u9F99\u706F\u201D\uFF0C\u9F99\u7EB9\u5206\u4E0A\u4E0B\u4E24\u5C42\u5E03\u5C40\uFF1A\u4E0A\u5C42\u56DB\u6761\uFF0C\u4E0B\u5C42\u56DB\u6761\uFF0C\u5E95\u90E8\u6B63\u4E2D\u518D\u9970\u4E00\u9F99\uFF0C\u4E5D\u9F99\u6392\u5E03\u89C4\u6574\u3001\u6C14\u52BF\u4E0D\u51E1\uFF0C\u5C3D\u663E\u5320\u5FC3\u3002\u4E5D\u9F99\u706F\u7528\u6599\u73CD\u7A00\u3001\u9020\u578B\u5E84\u91CD\u3001\u5B58\u4E16\u91CF\u6781\u5C11\uFF0C\u517C\u5177\u5386\u53F2\u4EF7\u503C\u4E0E\u827A\u672F\u4EF7\u503C\uFF0C\u662F\u96BE\u5F97\u4E00\u89C1\u7684\u73CD\u8D35\u6587\u7269\u3002\u3002\u7280\u725B\u671B\u6708\u955C   
