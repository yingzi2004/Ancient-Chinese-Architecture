  m_text: "\u56DB\u89D2\u4EAD\uFF08\u65B9\u4EAD\uFF09\u662F\u82CF\u5DDE\u56ED\u6797\u91CC\u6700\u5177\u4EE3\u8868\u6027\u7684\u4EAD\u5F0F\u4E4B\u4E00\uFF0C\u5B83\u4EE5\u6B63\u65B9\u5F62\u4E3A\u5E73\u9762\u57FA\u7840\uFF0C\u7ED3\u6784\u5BF9\u79F0\u5747\u8861\uFF0C\u9020\u578B\u89C4\u6574\u7A33\u91CD\uFF0C\u7ED9\u4EBA\u4EE5\u6C89\u9759\u96C5\u81F4\u7684\u89C2\u611F\u3002\u5B83\u7684\u5C4B\u9876\u591A\u4E3A\u5355\u6A90\u56DB\u89D2\u6512\u5C16\u9876\uFF0C\u7EBF\u6761\u7B80\u6D01\u5229\u843D\uFF0C\u65E2\u53EF\u4EE5\u72EC\u7ACB\u8BBE\u7F6E\u5728\u5EAD\u9662\u3001\u5C71\u5DC5\uFF0C\u4E5F\u53EF\u4E34\u6C34\u800C\u5EFA\uFF0C\u65E2\u80FD\u4F5C\u4E3A\u4F11\u61A9\u4E4B\u5904\uFF0C\u4E5F\u80FD\u51ED\u501F\u5BF9\u79F0\u7684\u6846\u666F\u6548\u679C\u6210\u4E3A\u56ED\u6797\u91CC\u7684\u89C6\u89C9\u7126\u70B9\uFF0C\u4F53\u73B0\u4E86
