  gardens:
  - name: "\u62D9\u653F\u56ED"
    texture: {fileID: 2800000, guid: 7da3eb437cfc1d244b6155482f3bf786, type: 3}
    bio: "\u62D9\u653F\u56ED\u662F\u4E2D\u56FD\u6C5F\u5357\u56ED\u6797\u7684\u6770\u51FA\u4EE3\u8868\u4E0E\u6C5F\u5357\u79C1\u5BB6\u82B1\u56ED\u5178\u8303\uFF0C\u4F4D\u4E8E\u6C5F\u82CF\u7701\u82CF\u5DDE\u5E02\u59D1\u82CF\u533A\u4E1C\u5317\u8857178\u53F7\uFF0C\u59CB\u5EFA\u4E8E\u660E\u6B63\u5FB7\u56DB\u5E74\uFF081509\u5E74\uFF09\uFF0C\u7531\u660E\u4EE3\u5FA1\u53F2\u738B\u732E\u81E3\u5728\u5510\u4EE3\u9646\u9F9F\u8499\u5B85\u5730\u4E0E\u5143\u4EE3\u5927\u5F18\u5BFA\u65E7\u5740\u62D3\u5EFA\u800C\u6210\uFF0C\u56ED\u540D\u53D6\u81EA\u664B\u4EE3\u6F58\u5CB3\u300A\u95F2\u5C45\u8D4B\u300B\u4E2D\u201C\u62D9\u8005\u4E4B\u4E3A\u653F\u201D\u4E4B\u610F\uFF0C\u636E\u4F20\u7531\u5434\u95E8\u753B\u6D3E\u6587\u5FB5\u660E\u53C2\u4E0E\u8BBE\u8BA1\uFF0C\u4EE5\u6C34\u4E3A\u4E3B\u3001\u758F\u6717\u81EA\u7136\uFF1B\u6B64\u540E\u5C61\u6613\u5176\u4E3B\uFF0C\u5386\u7ECF\u5174\u8870\uFF0C\u66FE\u5C5E\u592A\u5E73\u5929\u56FD\u5FE0\u738B\u5E9C\uFF0C1949\u5E74\u540E\u5F97\u5230\u4FDD\u62A4\u4FEE\u590D\uFF0C1952\u5E74\u6B63\u5F0F\u5BF9\u5916\u5F00\u653E\uFF0C1961\u5E74\u88AB\u5217\u4E3A\u9996\u6279\u5168\u56FD\u91CD\u70B9\u6587\u7269\u4FDD\u62A4\u5355\u4F4D\uFF0C1997\u5E74\u4E0E\u5176\u4ED6\u56ED\u6797\u4E00\u540C\u5217\u5165\u4E16\u754C\u6587\u5316\u9057\u4EA7\u3002\u5168\u56ED\u5360\u573078\u4EA9\uFF0852000\u5E73\u65B9\u7C73\uFF09\uFF0C\u5206\u4E1C\u3001\u4E2D\u3001\u897F\u4E09\u90E8\u5206\uFF0C\u53E6\u6709\u4F4F\u5B85\u90E8\u5206\u73B0\u4E3A\u56ED\u6797\u535A\u7269\u9986\u5C55\u5385\uFF0C\u4E1C\u90E8\u660E\u5FEB\u5F00\u6717\uFF0C\u4E2D\u90E8\u4E3A\u7CBE\u534E\u6240\u5728\u3001\u6C60\u6C34\u5360\u4E09\u5206\u4E4B\u4E00\uFF0C\u897F\u90E8\u4EE5\u66F2\u5C3A\u5F62\u6C34\u6C60\u4E0E\u7CBE\u5DE7\u56DE\u5ECA\u3001\u5345\u516D\u9E33\u9E2F\u9986\u7B49\u4E3A\u7279\u8272\uFF0C\u6574\u4F53\u5E03\u5C40\u81EA\u7136\uFF0C\u5EFA\u7B51\u9519\u843D\u6709\u81F4\uFF0C\u662F\u4E2D\u56FD\u53E4\u5178\u56ED\u6797\u7684\u7ECF\u5178\u4E4B\u4F5C\u3002"
    savedRotations: []
    isFinished: 0
  - name: "\u6CA7\u6D6A\u4EAD"
    texture: {fileID: 2800000, guid: 4415a17019592ee449fd5c3fa5953f77, type: 3}
    bio: "\u6CA7\u6D6A\u4EAD\u662F\u82CF\u5DDE\u73B0\u5B58\u6700\u53E4\u8001\u7684\u56ED\u6797\uFF0C\u4F4D\u4E8E\u82CF\u5DDE\u57CE\u5357\uFF0C\u59CB\u5EFA\u4E8E\u5317\u5B8B\u5E86\u5386\u5E74\u95F4\uFF0C\u7531\u8BD7\u4EBA\u82CF\u821C\u94A6\u8D2D\u5F97\u65E7\u56ED\u540E\u508D\u6C34\u5EFA\u4EAD\uFF0C\u53D6\u201C\u6CA7\u6D6A\u6FEF\u7F28\u201D\u4E4B\u610F\u547D\u540D\u3002\n\u56ED\u6797\u4EE5\u201C\u501F\u666F\u201D\u4E3A\u7279\u8272\uFF0C\u672A\u5165\u56ED\u5148\u89C1\u7EFF\u6C34\u73AF\u7ED5\uFF0C\u56ED\u5185\u4EE5\u5C71\u77F3\u4E3A\u4E3B\u666F\uFF0C\u4E3B\u4EAD\u7ACB\u4E8E\u571F\u5C71\u4E4B\u5DC5\uFF0C\u5C71\u6C34\u95F4\u4EE5\u590D\u5ECA\u3001\u6F0F\u7A97\u76F8\u8FDE\u3002\u4E3B\u8981\u5EFA\u7B51\u6709\u660E\u9053\u5802\u3001\u4E94\u767E\u540D\u8D24\u7960\u3001\u770B\u5C71\u697C\u7B49\uFF0C\u5176\u4E2D\u4E94\u767E\u540D\u8D24\u7960\u5D4C\u6709594\u5E45\u5386\u4EE3\u4EBA\u7269\u77F3\u523B\u50CF\u3002\u4EAD\u67F1\u6979\u8054\u201C\u6E05\u98CE\u660E\u6708\u672C\u65E0\u4EF7\uFF0C\u8FD1\u6C34\u8FDC\u5C71\u7686\u6709\u60C5\u201D\uFF0C\u96C6\u81EA\u6B27\u9633\u4FEE\u4E0E\u82CF\u821C\u94A6\u8BD7\u53E5\uFF0C\u662F\u5176\u70B9\u775B\u4E4B\u7B14\u3002"
    savedRotations: []
    isFinished: 0
  - name: "\u72EE\u5B50\u6797"
    texture: {fileID: 2800000, guid: f96b8b916fdc31042887fc53ca0c22f2, type: 3}
    bio: "\u72EE\u5B50\u6797\u4F4D\u4E8E\u6C5F\u82CF\u7701\u82CF\u5DDE\u5E02\u57CE\u533A\u4E1C\u5317\u89D2\u7684\u56ED\u6797\u8DEF23\u53F7\uFF0C\u5F00\u653E\u9762\u79EF\u7EA614\u4EA9\u3002\u72EE\u5B50\u6797\u662F\u82CF\u5DDE\u53E4\u5178\u56ED\u6797\u7684\u4EE3\u8868\u4E4B\u4E00\uFF0C\u88AB\u5217\u5165\u300A\u4E16\u754C\u6587\u5316\u9057\u4EA7\u540D\u5F55\u300B\uFF0C\u62E5\u6709\u56FD\u5185\u5C1A\u5B58\u6700\u5927\u7684\u53E4\u4EE3\u5047\u5C71\u7FA4\u3002\u6E56\u77F3\u5047\u5C71\u51FA\u795E\u5165\u5316\uFF0C\u88AB\u8A89\u4E3A\u201C\u5047\u5C71\u738B\u56FD\u201D\u3002"
    savedRotations: []
    isFinished: 0
  - name: "\u7559\u56ED"
    texture: {fileID: 2800000, guid: 96d7f3adc94b31041a867f65f66c6f53, type: 3}
    bio: "\u7559\u56ED\uFF0C\u4F4D\u4E8E\u4E2D\u56FD\u6C5F\u82CF\u7701\u82CF\u5DDE\u5E02\uFF0C\u662F\u4E2D\u56FD\u56DB\u5927\u540D\u56ED\u4E4B\u4E00\uFF0C\u59CB\u5EFA\u4E8E\u660E\u4EE3\uFF0C\u9762\u79EF\u7EA6\u4E3A
      23300 \u5E73\u65B9\u7C73\u3002\u7559\u56ED\u4EE5\u5176\u7CBE\u6E5B\u7684\u5EFA\u7B51\u827A\u672F\u548C\u72EC\u7279\u7684\u56ED\u6797\u5E03\u5C40\u800C\u8457\u79F0\uFF0C\u56ED\u5185\u6709\u4E30\u5BCC\u7684\u666F\u89C2\u5C42\u6B21\uFF0C\u878D\u5408\u4E86\u5C71\u6C34\u3001\u6797\u77F3\u7B49\u81EA\u7136\u5143\u7D20\uFF0C\u5C55\u73B0\u4E86\u81EA\u7136\u4E4B\u7F8E\u3002\u7559\u56ED\u4E8E
      1997 \u5E74\u88AB\u5217\u5165\u4E16\u754C\u6587\u5316\u9057\u4EA7\u540D\u5F55\uFF0C\u662F\u56FD\u5BB6
      5A \u7EA7\u65C5\u6E38\u666F\u533A\uFF0C\u5438\u5F15\u4E86\u4F17\u591A\u6E38\u5BA2\u524D\u6765\u6E38\u89C8\u3002"
