  dialoguePanel: {fileID: 606357286}
  dialogueText: {fileID: 30816568}
  dialogueLines:
  - "\u5377\u8F74\u7F13\u7F13\u5408\u4E0A\u4E86\u3002"
  - "\u90A3\u9053\u5149\u6536\u62E2\uFF0C\u8F7B\u8F7B\u4E00\u54CD\uFF0C\u4FBF\u5F52\u4E8E\u6C89\u5BC2\u3002"
  - "\u56DE\u8FC7\u795E\u6765\uFF0C\u6211\u5DF2\u7ECF\u56DE\u5230\u5BBF\u820D\uFF0C\u7A97\u5916\u662F\u719F\u6089\u7684\u8857\u666F\u3002"
  - "\u65E5\u5B50\u7167\u65E7\uFF0C\u4E0A\u8BFE\u4E0B\u8BFE\uFF0C\u7A7F\u8FC7\u64CD\u573A\u548C\u8857\u89D2\u3002"
  - "\u53EF\u6709\u4E9B\u4E1C\u897F\u4E0D\u4E00\u6837\u4E86\u3002"
  - "\r\u571F\u697C\u7684\u592F\u571F\u5899\uFF0C\u82CF\u5DDE\u7684\u82B1\u7A97\uFF0C\u664B\u5546\u7684\u7EA2\u706F\u7B3C\uFF0C\u5929\u575B\u7684\u84DD\u74E6\u3002"
  - "\u8FD9\u4E9B\u90FD\u4E0D\u662F\u8D70\u9A6C\u89C2\u82B1\u80FD\u77A7\u89C1\u7684\uFF0C\u662F\u771F\u771F\u5207\u5207\u8D70\u8FDB\u53BB\uFF0C\u88C5\u8FDB\u5FC3\u91CC\u7684\u3002"
  - "\u50CF\u4ECE\u4E00\u573A\u5F88\u957F\u5F88\u957F\u7684\u68A6\u91CC\u9192\u6765\uFF0C\u68A6\u91CC\u8D70\u4E86\u5F88\u8FDC\u7684\u8DEF\u3002"
  - "\u8FD9\u6837\u7684\u7ECF\u5386\uFF0C\u6015\u662F\u5F88\u96BE\u518D\u6709\u4E86\u5427\u3002"
  - "\u53EF\u5FC3\u91CC\u90A3\u70B9\u4E0D\u820D\uFF0C\u5F88\u5FEB\u5C31\u88AB\u66F4\u8E0F\u5B9E\u7684\u4E1C\u897F\u76D6\u8FC7\u53BB\u4E86\u3002"
  - "\u90A3\u4E9B\u8001\u6728\u5934\u8001\u77F3\u5934\u8001\u624B\u827A\uFF0C\u8FD8\u5728\u90A3\u91CC\uFF0C\u88AB\u98CE\u5439\u7740\uFF0C\u88AB\u5149\u7167\u7740\uFF0C\u88AB\u4EBA\u5B88\u7740\u3002"
  - "\u6211\u4E0D\u8FC7\u662F\u5148\u8D70\u4E00\u6B65\u3002"
  - "\u5B83\u4EEC\u8FD8\u4F1A\u9047\u89C1\u4E0B\u4E00\u4E2A\u613F\u610F\u6162\u6162\u8D70\uFF0C\u7EC6\u7EC6\u77A7\u7684\u4EBA\u3002"
  - "\u8FD9\u8D9F\u53E4\u5EFA\u4E4B\u65C5\uFF0C\u6CA1\u6709\u7EC8\u70B9\u3002"
  - "\u5B83\u53EA\u662F\u6362\u4E86\u4E2A\u65B9\u5F0F\uFF0C\u7EE7\u7EED\u8D70\u4E0B\u53BB\u7F62\u4E86\u3002"
