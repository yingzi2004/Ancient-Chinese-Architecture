  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91fc840ad474e04da0f5d756058dab7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  openingPanel: {fileID: 4430322333381265930}
  openingText: {fileID: 8379232225202623406}
  mapOpenPanel: {fileID: 5636979130499449410}
  mapOpenText: {fileID: 6702331765268405880}
  openingDialogue:
  - "\u4F60\u7F13\u7F13\u7741\u5F00\u773C"
  - "\u56DB\u5468\u662F\u4E00\u7247\u660F\u6697\uFF0C\u811A\u4E0B\u7684\u5730\u9762\u4F3C\u6709\u4F3C\u65E0\uFF0C\u7A7A\u6C14\u4E2D\u6D6E\u52A8\u7740\u6DE1\u6DE1\u58A8\u9999"
  - "\u4F60\u8BB0\u5F97\u524D\u4E00\u523B\uFF0C\u81EA\u5DF1\u8FD8\u8DDF\u7740\u53E4\u5EFA\u8003\u5BDF\u961F\u7684\u8001\u5E08\u4EEC\u5728\u95FD\u5357\u5C71\u95F4\u8D70\u8BBF\uFF0C\u624B\u91CC\u6367\u7740\u7B14\u8BB0\uFF0C\u8033\u6735\u91CC\u542C\u7740\u592F\u571F\u5899\u7684\u8BB2\u7A76\u3002"
  - "\u7136\u540E\u2014\u2014\u4F60\u5076\u7136\u6361\u5230\u4E00\u5377\u6CDB\u9EC4\u7684\u5377\u8F74\u3002"
  - "\u51FA\u4E8E\u597D\u5947\uFF0C\u4F60\u89E3\u5F00\u4E86\u7CFB\u7EF3\uFF0C\u8F7B\u8F7B\u5C55\u5F00\u2014\u2014"
  - "\u5C31\u5230\u4E86\u8FD9\u5947\u602A\u7684\u5730\u65B9"
  - "\u4F60\u4F4E\u5934\u770B\u4E86\u770B\u81EA\u5DF1\u7684\u624B\u3002\u7A7A\u7A7A\u5982\u4E5F\u3002"
  - "\u90A3\u5377\u8F74\u5462\uFF1F"
  - "\u4F60\u8BD5\u7740\u56DE\u60F3\u2014\u2014\u6253\u5F00\u5377\u8F74\u7684\u77AC\u95F4\uFF0C\u610F\u8BC6\u5C31\u50CF\u88AB\u4EC0\u4E48\u8F7B\u8F7B\u6258\u4E86\u4E00\u4E0B\uFF0C\u7136\u540E\u4FBF\u6A21\u7CCA\u4E86\u3002"
  - "\u518D\u9192\u6765\uFF0C\u5C31\u662F\u8FD9\u91CC\u3002"
  - "\u4E00\u4E2A\u4E0D\u592A\u50CF\u73B0\u5B9E\u3001\u53C8\u4E0D\u50CF\u68A6\u5883\u7684\u5730\u65B9\u3002"
  mapOpenDialogue:
  - "\u6B63\u60F3\u7740\uFF0C\u773C\u524D\u5FFD\u7136\u4EAE\u4E86\u8D77\u6765\u3002"
  - "\u90A3\u5377\u53E4\u65E7\u7684\u5377\u8F74\uFF0C\u6B63\u5B89\u9759\u5730\u60AC\u6D6E\u5728\u4F60\u9762\u524D\uFF0C\u7F13\u7F13\u94FA\u5F00\u3002"
