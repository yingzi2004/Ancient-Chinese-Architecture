  m_Script: {fileID: 11500000, guid: e91fc840ad474e04da0f5d756058dab7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  openingPanel: {fileID: 1711041032}
  openingText: {fileID: 1378362404}
  mapOpenPanel: {fileID: 302921958}
  mapOpenText: {fileID: 508561122}
  openingDialogue:
  - "\u4F60\u7F13\u7F13\u7741\u5F00\u773C\u3002"
  - "\u56DB\u5468\u662F\u4E00\u7247\u660F\u6697\uFF0C\u811A\u4E0B\u7684\u5730\u9762\u4F3C\u6709\u4F3C\u65E0\uFF0C\u7A7A\u6C14\u4E2D\u6D6E\u52A8\u7740\u6DE1\u6DE1\u7684\u58A8\u9999\u3002"
  - "\u4F60\u8BB0\u5F97\u524D\u4E00\u523B\uFF0C\u81EA\u5DF1\u8FD8\u8DDF\u7740\u53E4\u5EFA\u8003\u5BDF\u961F\u7684\u8001\u5E08\u4EEC\u5728\u95FD\u5357\u5C71\u95F4\u8D70\u8BBF\uFF0C\u624B\u91CC\u6367\u7740\u7B14\u8BB0\uFF0C\u8033\u6735\u91CC\u542C\u7740\u592F\u571F\u5899\u7684\u8BB2\u7A76\u3002"
  - "\u7136\u540E\u2014\u2014\u4F60\u5076\u7136\u6361\u5230\u4E00\u5377\u6CDB\u9EC4\u7684\u5377\u8F74\u3002"
  - "\u51FA\u4E8E\u597D\u5947\uFF0C\u4F60\u89E3\u5F00\u4E86\u7CFB\u7EF3\uFF0C\u8F7B\u8F7B\u5C55\u5F00\u2014\u2014"
  - "\u5C31\u5230\u4E86\u8FD9\u5947\u602A\u7684\u5730\u65B9"
  - "\u4F60\u4F4E\u5934\u770B\u4E86\u770B\u81EA\u5DF1\u7684\u624B\u3002\u7A7A\u7A7A\u5982\u4E5F\u3002"
  - "\u90A3\u5377\u8F74\u5462\uFF1F"
  - "\u4F60\u8BD5\u7740\u56DE\u60F3\u2014\u2014\u6253\u5F00\u5377\u8F74\u7684\u77AC\u95F4\uFF0C\u610F\u8BC6\u5C31\u50CF\u88AB\u4EC0\u4E48\u8F7B\u8F7B\u6258\u4E86\u4E00\u4E0B\uFF0C\u7136\u540E\u4FBF\u6A21\u7CCA\u4E86\u3002"
  - "\u518D\u9192\u6765\uFF0C\u5C31\u662F\u8FD9\u91CC\u3002"
  - "\u4E00\u4E2A\u4E0D\u592A\u50CF\u73B0\u5B9E\u3001\u53C8\u4E0D\u50CF\u68A6\u5883\u7684\u5730\u65B9\u3002"
  mapOpenDialogue:
  - "\u6B63\u60F3\u7740\uFF0C\u773C\u524D\u5FFD\u7136\u4EAE\u4E86\u8D77\u6765\u3002"
  - "\u90A3\u5377\u53E4\u65E7\u7684\u5377\u8F74\uFF0C\u6B63\u5B89\u9759\u5730\u60AC\u6D6E\u5728\u4F60\u9762\u524D\uFF0C\u7F13\u7F13\u94FA\u5F00\u3002"
  - "\u6CDB\u9EC4\u7684\u7EB8\u9762\u4E0A\uFF0C\u58A8\u8FF9\u6E10\u6B21\u6D6E\u73B0\u2014\u2014\u4E00\u5EA7\u5706\u5F62\u7684\u571F\u697C\uFF0C\u4E00\u65B9\u7CBE\u5DE7\u7684\u56ED\u6797\uFF0C\u4E00\u5EA7\u6DF1\u5B85\u5927\u9662\uFF0C\u4E00\u9876\u6E5B\u84DD\u7684\u7A79\u9876\u3002"
  - "\u4F60\u51E0\u4E4E\u662F\u4E0B\u610F\u8BC6\u5730\u5728\u5FC3\u91CC\u6392\u5217\u4E86\u4E00\u904D\uFF1A\u798F\u5EFA\u3001\u82CF\u5DDE\u3001\u5C71\u897F\u3001\u5317\u4EAC\u3002\u4ECE\u5357\u5230\u5317\u3002\u4E00\u6761\u5B8C\u6574\u7684\u53E4\u5EFA\u8109\u7EDC\u3002"
  - "\u4F60\u7684\u5FC3\u8DF3\u5FEB\u4E86\u4E00\u62CD\u3002\u8FD9\u53EF\u4E0D\u662F\u968F\u4FBF\u4EC0\u4E48\u4EBA\u7684\u6D82\u9E26\uFF0C\u8FD9\u662F\u6709\u4EBA\u2014\u2014\u6216\u8005\u8BF4\uFF0C\u6709\u4EC0\u4E48\u2014\u2014\u628A\u56DB\u6D3E\u53E4\u5EFA\u7684\u6C14\u97F5\uFF0C\u4E00\u7B14\u4E00\u7B14\u6536\u8FDB\u4E86\u8FD9\u5377\u8F74\u91CC\u3002"
  - "\u4F60\u7684\u76EE\u5149\u843D\u5728\u7B2C\u4E00\u5E45\u753B\u4E0A"
  - "\u90A3\u5EA7\u571F\u697C\u7684\u8F6E\u5ED3\u8F7B\u8F7B\u8DF3\u52A8\u8D77\u6765\uFF0C\u50CF\u662F\u5728\u62DB\u547C\u4F60\uFF0C\u53C8\u50CF\u662F\u5728\u7B49\u4F60\u8BA4\u9886\u3002"
  - "\u4F60\u72B9\u8C6B\u4E86\u4E00\u77AC\uFF0C\u7136\u540E\u4F38\u51FA\u624B\uFF0C\u6307\u5C16\u89E6\u4E0A\u90A3\u7247\u58A8\u8FF9\u2014\u2014"
  typingSpeed: 0.05
