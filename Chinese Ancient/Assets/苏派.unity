  - {fileID: 21300000, guid: 3b891bba1416fe940be07d0c9745dc8e, type: 3}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 21300000, guid: ce876d84ff38c4445858d093c18b1031, type: 3}
  - {fileID: 0}
  - {fileID: 21300000, guid: 3b891bba1416fe940be07d0c9745dc8e, type: 3}
  dialogueLines:
  - "\u54A6\uFF1F\u5BA2\u5B98\uFF01\u4F60\u4E5F\u901B\u5230\u8FD9\u513F\u6765\u5566\uFF1F\r\n\uFF08\u5C0F\u5FAE\u7B11\u5F97\u7709\u773C\u5F2F\u5F2F\uFF0C\u4F38\u624B\u6307\u5411\u6EE1\u6C60\u8377\u82B1\uFF09"
  - "\u8FD9\u6C60\u8377\u82B1\uFF0C\u662F\u4E0D\u662F\u7F8E\u5F97\u8BA9\u4EBA\u8D70\u4E0D\u52A8\u9053\uFF1F\u6211\u65B9\u624D\u5728\u8FD9\u513F\u7AD9\u4E86\u597D\u4E45\uFF0C\u600E\u4E48\u770B\u90FD\u770B\u4E0D\u591F\uFF01"
